{
  "name": "vscode-aivi",
  "displayName": "AIVI",
  "description": "AIVI language support — syntax, diagnostics, formatting, and intelligence",
  "version": "0.1.0",
  "publisher": "aivi-lang",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Programming Languages",
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "aivi",
    "functional",
    "reactive",
    "gtk",
    "linux"
  ],
  "license": "GPL-3.0-only",
  "icon": "icons/aivi-a.png",
  "main": "./dist/extension.js",
  "files": [
    "dist/extension.js",
    "icons/**",
    "snippets/**",
    "syntaxes/**",
    "themes/**",
    "language-configuration.json",
    "README.md",
    "licence.txt"
  ],
  "activationEvents": [
    "onLanguage:aivi"
  ],
  "contributes": {
    "languages": [
      {
        "id": "aivi",
        "aliases": [
          "AIVI",
          "aivi"
        ],
        "extensions": [
          ".aivi"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/aivi-file.svg",
          "dark": "./icons/aivi-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "aivi",
        "scopeName": "source.aivi",
        "path": "./syntaxes/aivi.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "aivi",
        "path": "./snippets/aivi.json"
      }
    ],
    "themes": [
      {
        "label": "AIVI Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/aivi-dark-color-theme.json"
      }
    ],
    "configurationDefaults": {
      "[aivi]": {
        "editor.defaultFormatter": "aivi-lang.vscode-aivi",
        "editor.fontLigatures": true,
        "editor.fontFamily": "'Fira Code', 'Cascadia Code', 'JetBrains Mono', 'Maple Mono', monospace",
        "editor.rulers": [
          100
        ],
        "editor.renderWhitespace": "boundary",
        "editor.semanticHighlighting.enabled": true
      }
    },
    "commands": [
      {
        "command": "aivi.restartServer",
        "title": "AIVI: Restart Language Server"
      },
      {
        "command": "aivi.showOutputChannel",
        "title": "AIVI: Show Output Channel"
      },
      {
        "command": "aivi.formatDocument",
        "title": "AIVI: Format Document",
        "when": "editorLangId == aivi"
      },
      {
        "command": "aivi.checkFile",
        "title": "AIVI: Check Current File",
        "when": "editorLangId == aivi"
      },
      {
        "command": "aivi.runTest",
        "title": "AIVI: Run Test",
        "when": "editorLangId == aivi"
      }
    ],
    "configuration": {
      "title": "AIVI",
      "properties": {
        "aivi.compiler.path": {
          "type": "string",
          "default": "aivi",
          "description": "Path to the aivi compiler binary."
        },
        "aivi.compiler.timeout": {
          "type": "number",
          "default": 15000,
          "minimum": 1000,
          "maximum": 120000,
          "description": "Maximum time to wait for the language server to start, in milliseconds."
        },
        "aivi.diagnostics.debounceMs": {
          "type": "number",
          "default": 200,
          "minimum": 0,
          "maximum": 5000,
          "description": "Delay before triggering diagnostics after a document change."
        },
        "aivi.inlayHints.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show inferred type inlay hints."
        },
        "aivi.inlayHints.maxLength": {
          "type": "number",
          "default": 30,
          "minimum": 4,
          "maximum": 200,
          "description": "Maximum character length of an inlay hint before truncation."
        },
        "aivi.codeLens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show code lens annotations."
        },
        "aivi.format.onSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically format AIVI files on save."
        }
      }
    }
  },
  "scripts": {
    "build": "vite build",
    "lint": "tsc --noEmit",
    "watch": "vite build --watch",
    "test": "pnpm run test:compile && pnpm run test:unit && pnpm run test:server && pnpm run test:integration",
    "test:compile": "tsc -p tsconfig.test.json",
    "test:unit": "node --test test-out/tests/contract.test.js test-out/tests/lifecycle.test.js",
    "test:server": "cargo build --manifest-path ../../../Cargo.toml --bin aivi",
    "test:integration": "node --test test-out/tests/lsp.integration.test.js",
    "package": "vsce package --no-dependencies --allow-missing-repository && node scripts/verify-vsix.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "^10.1.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/vscode": "^1.134.0",
    "@vscode/vsce": "3.9.2",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
