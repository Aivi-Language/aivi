use aivi.core.either (
    Either
    Left
    Right
)

use aivi.core.dict (
    Dict
    fromList as dictFromList
    toList as dictToList
    keys as dictKeys
)

use aivi.core.set (
    Set
    fromList as setFromList
)

use aivi.nonEmpty (
    NonEmptyList
    fromHeadTail
    toList as nelToList
)

use aivi.matrix (
    Matrix
    MatrixError
    fromRows
    init as matrixInit
    rows as matrixRows
    width as matrixWidth
    height as matrixHeight
)

type Int -> Int
func increment = n =>
    n + 1

type Functor F => F Int -> F Int
func incrementInline = values =>
    map (n => n + 1) values

type Functor F => A -> F Int -> F A
func replaceInline = captured values =>
    map (n => captured) values

type (Functor F, Eq A) => A -> F A -> F Bool
func matchesInline = captured values =>
    map (n => n == captured) values

type Int -> Int -> Int
func accumulate = total n =>
    total * 10 + n

type Int -> Option Int
func keepPositive = n => n > 0
 T|> Some (n + 1)
 F|> None

value right : Either Text Int = Right 2
value mappedRight : Either Text Int = map increment right
value expectedRight : Either Text Int = Right 3

value dictionary : Dict Text Int =
    dictFromList [
        ("b", 2),
        ("a", 1)
    ]

value mappedDictionary : Dict Text Int = map increment dictionary
value filteredDictionary : Dict Text Int = filterMap keepPositive dictionary

value items : NonEmptyList Int =
    fromHeadTail 1 [
        2,
        3
    ]

value mappedItems : NonEmptyList Int = map increment items

value set : Set Int =
    setFromList [
        3,
        1,
        3,
        2
    ]

value emptyDictionary : Dict Text Int = default
value emptySet : Set Int = default

@test
value eitherFunctor : Task Text Bool = pure (mappedRight == expectedRight)

@test
value dictFunctor : Task Text Bool = pure (dictToList mappedDictionary == [("a", 2), ("b", 3)])

@test
value dictFilterable : Task Text Bool = pure (dictToList filteredDictionary == [("a", 2), ("b", 3)])

@test
value dictFoldable : Task Text Bool = pure (reduce accumulate 0 dictionary == 12)

@test
value nelFunctor : Task Text Bool = pure (nelToList mappedItems == [2, 3, 4])

@test
value nelInlineFunctor : Task Text Bool = pure (nelToList (incrementInline items) == [2, 3, 4])

@test
value dictInlineFunctor : Task Text Bool = pure (dictToList (incrementInline dictionary) == [("a", 2), ("b", 3)])

@test
value eitherInlineCapture : Task Text Bool = pure (replaceInline "kept" right == Right "kept")

@test
value nelInlineEvidence : Task Text Bool = pure (nelToList (matchesInline 2 items) == [False, True, False])

@test
value nelFoldable : Task Text Bool = pure (reduce accumulate 0 items == 123)

@test
value setFoldable : Task Text Bool = pure (reduce accumulate 0 set == 312)

@test
value dictDefault : Task Text Bool = pure (dictToList emptyDictionary == [])

@test
value setDefault : Task Text Bool = pure (reduce accumulate 0 emptySet == 0)

use aivi.core.bytes (
    fromText
    toText
)

type Int -> Int
func identityInt = n =>
    n

type Int -> Int
func double = n =>
    n * 2

type Int -> Int
func doubleAfterIncrement = n =>
    double (increment n)

type Int -> Either Text Int
func nextRight = n =>
    Right (n + 1)

type Int -> NonEmptyList Int
func nextItems = n =>
    fromHeadTail n [n + 10]

value left : Either Text Int = Left "stop"
value rightPure : Either Text Int = pure 2
value rightFunctions : Either Text (Int -> Int) = Right increment
value leftFunctions : Either Text (Int -> Int) = Left "first"
value appliedRight : Either Text Int = apply rightFunctions right
value appliedLeft : Either Text Int = apply leftFunctions left
value chainedRight : Either Text Int = chain nextRight right
value chainedLeft : Either Text Int = chain nextRight left
value nestedRight : Either Text (Either Text Int) = Right right
value joinedRight : Either Text Int = join nestedRight

value functionItems : NonEmptyList (Int -> Int) =
    fromHeadTail increment [
        double
    ]

value appliedItems : NonEmptyList Int = apply functionItems items
value chainedItems : NonEmptyList Int = chain nextItems items
value pureItems : NonEmptyList Int = pure 2

value nestedItems : NonEmptyList (NonEmptyList Int) =
    fromHeadTail items [
        pureItems
    ]

value joinedItems : NonEmptyList Int = join nestedItems
value appendedItems : NonEmptyList Int = append items pureItems
value byteA : Bytes = fromText "a"
value byteB : Bytes = fromText "b"
value emptyBytes : Bytes = empty
value defaultBytes : Bytes = default
value appendedBytes : Bytes = append byteA byteB

value mixedDictionary : Dict Text Int =
    dictFromList [
        ("a", 1),
        ("b", -1),
        ("c", 2)
    ]

value selectedDictionary : Dict Text Int = filterMap keepPositive mixedDictionary

@test
value eitherIdentity : Task Text Bool = pure (map identityInt right == right)

@test
value eitherComposition : Task Text Bool = pure (map double (map increment right) == map doubleAfterIncrement right)

@test
value eitherLeftPreserved : Task Text Bool = pure (map increment left == left)

@test
value eitherApplicative : Task Text Bool = pure ((rightPure, appliedRight, appliedLeft) == (right, expectedRight, Left "first"))

@test
value eitherMonad : Task Text Bool = pure ((chainedRight, chainedLeft, joinedRight) == (expectedRight, left, right))

@test
value eitherFoldOrder : Task Text Bool = pure ((reduce accumulate 4 right, reduce accumulate 4 left) == (42, 4))

@test
value nonEmptyIdentity : Task Text Bool = pure (nelToList (map identityInt items) == nelToList items)

@test
value nonEmptyComposition : Task Text Bool = pure (nelToList (map double (map increment items)) == nelToList (map doubleAfterIncrement items))

@test
value nonEmptyApplyOrder : Task Text Bool = pure (nelToList appliedItems == [2, 3, 4, 2, 4, 6])

@test
value nonEmptyChainOrder : Task Text Bool = pure (nelToList chainedItems == [1, 11, 2, 12, 3, 13])

@test
value nonEmptyJoin : Task Text Bool = pure (nelToList joinedItems == [1, 2, 3, 2])

@test
value nonEmptyAppend : Task Text Bool = pure (nelToList appendedItems == [1, 2, 3, 2])

@test
value dictIdentity : Task Text Bool = pure (dictToList (map identityInt dictionary) == dictToList dictionary)

@test
value dictFilterPreservesKeys : Task Text Bool = pure (dictToList selectedDictionary == [("c", 3), ("a", 2)])

@test
value bytesClassOperations : Task Text Bool = pure ((toText appendedBytes, toText emptyBytes, toText defaultBytes) == (Some "ab", Some "", Some ""))

value eitherMapper : (Int -> Int) -> Either Text Int -> Either Text Int = map
value mappedByValue : Either Text Int = eitherMapper increment right

type Text -> Int
func constantSeven = text =>
    7

value bothMapped : Either Int Int = bimap constantSeven increment left
value eitherBimapExpected : Either Int Int = Left 7
value appendLeft : NonEmptyList Int = append (append items pureItems) items
value appendRight : NonEmptyList Int = append items (append pureItems items)

@test
value classMethodAsValue : Task Text Bool = pure (mappedByValue == expectedRight)

@test
value eitherBifunctor : Task Text Bool = pure (bothMapped == eitherBimapExpected)

@test
value nonEmptyAppendAssociative : Task Text Bool = pure (nelToList appendLeft == nelToList appendRight)

type (Traversable F, Applicative G) => (Int -> G Int) -> F Int -> G (F Int)
func traverseGeneric = f values => traverse f values

type Int -> Either Text Int
func incrementRight = n => Right (n + 1)

type Int -> Task Text Int
func incrementTask = n => pure (n + 1)

value emptyRight : Either Text (List Int) = Right []
value sourceError : Result Text Int = Err "source"
value sourceInvalid : Validation Text Int = Invalid "source"

@test
value traverseBuiltinDictionary : Task Text Bool = pure (traverseGeneric keepPositive (Some 2) == Some (Some 3))

@test
value traverseAuthoredApplicative : Task Text Bool = pure (traverseGeneric incrementRight [1, 2] == Right [2, 3])

@test
value traverseEmptyApplicative : Task Text Bool = pure (traverseGeneric incrementRight [] == emptyRight)

@test
value traverseTask : Task Text Bool = map (values => values == [2, 3]) (traverseGeneric incrementTask [1, 2])

@test
value traverseEmptyTask : Task Text Bool = map (values => values == []) (traverseGeneric incrementTask [])

@test
value traverseSourceError : Task Text Bool = pure (traverseGeneric incrementRight sourceError == Right sourceError)

@test
value traverseSourceInvalid : Task Text Bool = pure (traverseGeneric incrementRight sourceInvalid == Right sourceInvalid)

// Authored Traversable instances receive the same method-local Applicative dictionary.
value traversedDictionary : Option (Dict Text Int) = traverseGeneric keepPositive dictionary
value traversedItems : Option (NonEmptyList Int) = traverseGeneric keepPositive items
value failingDictionary : Dict Text Int = { entries: [{ key: "first", value: 1 }, { key: "second", value: -1 }] }
value functionKeyDictionary : Dict (Int -> Int) Int = { entries: [{ key: increment, value: 2 }] }

type Dict (Int -> Int) Int -> (Int, List Int)
func inspectFunctionKeys = values =>
    (reduce (n f => f n) 10 (dictKeys values), reduce (acc n => append acc [n]) [] values)

type Int -> List Int
func alternatives = n =>
    [n, n + 10]

type Int -> Result Text Int
func positiveResult = n => n > 0
 T|> Ok (n + 1)
 F|> Err "negative"

type Int -> Validation (NonEmptyList Text) Int
func rejectValidation = n => n
 ||> 1 -> Invalid (fromHeadTail "first" [])
 ||> _ -> Invalid (fromHeadTail "second" [])

value eitherTraverser : (Int -> Option Int) -> Either Text Int -> Option (Either Text Int) = traverse
value dictionaryTraverser : Dict Text Int -> Option (Dict Text Int) = traverse keepPositive
value nelTraverser : NonEmptyList Int -> Option (NonEmptyList Int) = traverse keepPositive

@test
value eitherTraverseRight : Task Text Bool = pure (traverseGeneric keepPositive right == Some (Right 3))

@test
value eitherTraverseLeft : Task Text Bool = pure (traverseGeneric (n => None) left == Some left)

@test
value eitherTraverseFailure : Task Text Bool = pure (traverseGeneric (n => None) right == None)

@test
value eitherTraverseAuthoredApplicative : Task Text Bool = pure (traverseGeneric incrementRight right == Right (Right 3))

@test
value eitherTraverseFirstClass : Task Text Bool = pure (eitherTraverser keepPositive right == Some (Right 3))

@test
value dictTraverseOrder : Task Text Bool = pure (map dictToList traversedDictionary == Some [("a", 2), ("b", 3)])

@test
value dictTraverseEmpty : Task Text Bool = pure (map dictToList (traverseGeneric (n => None) emptyDictionary) == Some [])

@test
value dictTraverseFailure : Task Text Bool = pure (traverseGeneric keepPositive failingDictionary == None)

@test
value dictTraverseNoKeyEquality : Task Text Bool = pure (map inspectFunctionKeys (traverseGeneric keepPositive functionKeyDictionary) == Some (11, [3]))

@test
value dictTraversePartial : Task Text Bool = pure (map dictToList (dictionaryTraverser dictionary) == Some [("a", 2), ("b", 3)])

@test
value dictTraverseAlternatives : Task Text Bool = pure (map dictToList (traverseGeneric alternatives dictionary) == [[("a", 1), ("b", 2)], [("a", 1), ("b", 12)], [("a", 11), ("b", 2)], [("a", 11), ("b", 12)]])

@test
value nelTraverseOrder : Task Text Bool = pure (map nelToList traversedItems == Some [2, 3, 4])

@test
value nelTraverseSingleton : Task Text Bool = pure (map nelToList (traverseGeneric keepPositive pureItems) == Some [3])

@test
value nelTraverseHeadFailure : Task Text Bool = pure (traverseGeneric positiveResult (fromHeadTail -1 [2]) == Err "negative")

@test
value nelTraverseTailFailure : Task Text Bool = pure (traverseGeneric positiveResult (fromHeadTail 1 [-1]) == Err "negative")

@test
value nelTraversePartial : Task Text Bool = pure (map nelToList (nelTraverser items) == Some [2, 3, 4])

@test
value nelTraverseAlternatives : Task Text Bool = pure (map nelToList (traverseGeneric alternatives (fromHeadTail 1 [2])) == [[1, 2], [1, 12], [11, 2], [11, 12]])

@test
value nelTraverseValidation : Task Text Bool = pure (traverseGeneric rejectValidation (fromHeadTail 1 [2]) == Invalid (fromHeadTail "first" ["second"]))

type Matrix Int -> Bool
func matrixTraversalMatches = matrix =>
    map matrixRows (traverseGeneric keepPositive matrix) == Some [[2, 3], [4, 5]]
    and map matrixWidth (traverseGeneric keepPositive matrix) == Some 2
    and map matrixHeight (traverseGeneric keepPositive matrix) == Some 2

type Int -> Int -> Matrix Int -> Bool
func emptyMatrixTraversalMatches = width height matrix =>
    map matrixWidth (traverseGeneric (n => None) matrix) == Some width
    and map matrixHeight (traverseGeneric (n => None) matrix) == Some height
    and map matrixRows (traverseGeneric (n => None) matrix) == Some (matrixRows matrix)

type Matrix Int -> Bool
func matrixTraversalFails = matrix =>
    traverseGeneric keepPositive matrix == None

type Matrix Int -> Bool
func matrixValidationOrder = matrix =>
    traverseGeneric rejectValidation matrix == Invalid (fromHeadTail "first" ["second"])

type Matrix Int -> Bool
func matrixAlternatives = matrix =>
    map matrixRows (traverseGeneric alternatives matrix) == [[[1, 2]], [[1, 12]], [[11, 2]], [[11, 12]]]

type Result MatrixError Bool -> Bool
func matrixCheck = checked => checked
 ||> Ok passed -> passed
 ||> Err _     -> False

@test
value matrixTraverseShape : Task Text Bool = pure (matrixCheck (map matrixTraversalMatches (fromRows [[1, 2], [3, 4]])))

@test
value matrixTraverseZeroWidth : Task Text Bool = pure (matrixCheck (map (emptyMatrixTraversalMatches 0 3) (matrixInit 0 3 (x y => 1))))

@test
value matrixTraverseZeroHeight : Task Text Bool = pure (matrixCheck (map (emptyMatrixTraversalMatches 4 0) (matrixInit 4 0 (x y => 1))))

@test
value matrixTraverseFailure : Task Text Bool = pure (matrixCheck (map matrixTraversalFails (fromRows [[1, 2], [-1, 4]])))

@test
value matrixTraverseValidationOrder : Task Text Bool = pure (matrixCheck (map matrixValidationOrder (fromRows [[1], [2]])))

@test
value matrixTraverseAlternatives : Task Text Bool = pure (matrixCheck (map matrixAlternatives (fromRows [[1, 2]])))

// Identity, naturality and composition use executable authored Applicative dictionaries.
type Identity A = Identity A
instance Functor Identity = { map = f identity => identity ||> Identity a -> Identity (f a) }
instance Apply Identity = { apply = functions values => functions ||> Identity f -> map f values }
instance Applicative Identity = { pure = a => Identity a }

type Identity A -> A
func unwrapIdentity = identity => identity
 ||> Identity a -> a

type Option A -> List A
func optionAsList = option => option
 ||> None   -> []
 ||> Some a -> [a]

type Int -> List Int
func positiveAsList = n =>
    optionAsList (keepPositive n)

type OptionList A = OptionList (Option (List A))
instance Functor OptionList = { map = f composed => composed ||> OptionList nested -> OptionList (map (map f) nested) }
instance Apply OptionList = { apply = functions values => (functions, values) ||> (OptionList fs, OptionList xs) -> OptionList (apply (map apply fs) xs) }
instance Applicative OptionList = { pure = a => OptionList (Some [a]) }

type Int -> OptionList Int
func composedChoices = n =>
    OptionList (Some (alternatives n))

type Int -> Option Int
func keep = n =>
    Some n

type (Traversable F, Eq (F Int)) => F Int -> Bool
func traversalIdentity = values =>
    unwrapIdentity (traverse Identity values) == values

type (Traversable F, Eq (F Int)) => F Int -> Bool
func traversalNaturality = values =>
    optionAsList (traverse keepPositive values) == traverse positiveAsList values

type (Traversable F, Eq (F Int)) => F Int -> Bool
func traversalComposition = values =>
    traverse composedChoices values == OptionList (map (traverse alternatives) (traverse keep values))

type (Traversable F, Eq (F Int)) => F Int -> Bool
func traversalLaws = values =>
    traversalIdentity values and traversalNaturality values and traversalComposition values

@test
value eitherTraverseLaws : Task Text Bool = pure (traversalLaws right and traversalLaws left)

@test
value dictTraverseLaws : Task Text Bool = pure (traversalLaws dictionary and traversalLaws emptyDictionary and traversalNaturality failingDictionary)

@test
value nelTraverseLaws : Task Text Bool = pure (traversalLaws items and traversalLaws pureItems and traversalNaturality (fromHeadTail -1 [2]))

@test
value matrixTraverseLaws : Task Text Bool = pure (matrixCheck (map traversalLaws (fromRows [[1, 2], [3, 4]])))

@test
value eitherTraverseTask : Task Text Bool = map (value => value == Right 3) (traverseGeneric incrementTask right)

@test
value dictTraverseTask : Task Text Bool = map (value => dictToList value == [("a", 2), ("b", 3)]) (traverseGeneric incrementTask dictionary)

@test
value nelTraverseTask : Task Text Bool = map (value => nelToList value == [2, 3, 4]) (traverseGeneric incrementTask items)

type Matrix Int -> Task Text Bool
func matrixTraversalTask = matrix =>
    map (value => matrixRows value == [[2, 3], [4, 5]]) (traverseGeneric incrementTask matrix)

value checkedMatrixTask : Task Text Bool = fromRows [[1, 2], [3, 4]]
 ||> Ok matrix -> matrixTraversalTask matrix
 ||> Err _     -> pure False

@test
value matrixTraverseTask : Task Text Bool = checkedMatrixTask
