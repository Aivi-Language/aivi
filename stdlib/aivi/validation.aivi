use aivi.nonEmpty (NonEmptyList)

type Errors E = NonEmptyList E

type Validation E A -> Bool
func isValid = opt => opt
 T|> True
 F|> False

type Validation E A -> Bool
func isInvalid = opt => opt
 F|> True
 T|> False

type A -> (Validation E A) -> A
func getOrElse = fallback opt => opt
 ||> Valid item -> item
 ||> Invalid _  -> fallback

type (E1 -> E2) -> (Validation E1 A) -> (Validation E2 A)
func mapErr = transform opt => opt
 ||> Valid item  -> Valid item
 ||> Invalid err -> Invalid (transform err)

type Validation E A -> (Result E A)
func toResult = opt => opt
 ||> Valid item  -> Ok item
 ||> Invalid err -> Err err

type Result E A -> (Validation E A)
func fromResult = opt => opt
 ||> Ok item   -> Valid item
 ||> Err error -> Invalid error

type Validation E A -> (Option A)
func toOption = opt => opt
 ||> Valid item -> Some item
 ||> Invalid _  -> None

type (A -> B) -> (Validation E A) -> (Validation E B)
func map = transform opt => opt
 ||> Invalid e  -> Invalid e
 ||> Valid item -> Valid (transform item)

type (A -> Validation E B) -> (Validation E A) -> (Validation E B)
func andThen = next opt => opt
 ||> Invalid e  -> Invalid e
 ||> Valid item -> next item

type (E -> B) -> (A -> B) -> (Validation E A) -> B
func fold = onInvalid onValid opt => opt
 ||> Invalid e  -> onInvalid e
 ||> Valid item -> onValid item

type Int -> Int
func incrementForTest = n =>
    n + 1

type Text -> Text
func prefixForTest = text =>
    append "error: " text

type Int -> Validation Text Int
func incrementValidForTest = n =>
    Valid (n + 1)

type Text -> Int
func errorZeroForTest = text =>
    0

type Option Int -> Bool
func optionIsTwoForTest = opt => opt
 ||> Some n -> n == 2
 ||> None   -> False

@test
value validation_isValid : Task Text Bool = pure (isValid (Valid 2))

@test
value validation_isInvalid : Task Text Bool = pure (isInvalid (Invalid "bad"))

@test
value validation_getOrElse : Task Text Bool = pure (getOrElse 0 (Valid 2) == 2)

@test
value validation_mapErr : Task Text Bool = pure (mapErr prefixForTest (Invalid "bad") == Invalid "error: bad")

@test
value validation_toResult : Task Text Bool = pure (toResult (Valid 2) == Ok 2)

@test
value validation_fromResult : Task Text Bool = pure (fromResult (Ok 2) == Valid 2)

@test
value validation_toOption : Task Text Bool = pure (optionIsTwoForTest (toOption (Valid 2)))

@test
value validation_map : Task Text Bool = pure (map incrementForTest (Valid 2) == Valid 3)

@test
value validation_andThen : Task Text Bool = pure (andThen incrementValidForTest (Valid 2) == Valid 3)

@test
value validation_fold : Task Text Bool = pure (fold errorZeroForTest incrementForTest (Valid 2) == 3)

export Errors
export isValid
export isInvalid
export getOrElse
export mapErr
export toResult
export fromResult
export toOption
export map
export andThen
export fold
