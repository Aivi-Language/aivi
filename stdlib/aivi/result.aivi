hoist

type A -> (Result E A)
func keepOk = item =>
    Ok item

type E -> (Result E A)
func keepErr = error =>
    Err error

type (E1 -> E2) -> E1 -> (Result E2 A)
func mapError = transform error =>
    Err (transform error)

type A -> (Option A)
func keepSome = item =>
    Some item

type A -> (List A)
func singleton = item =>
    [item]

type Result E A -> Bool
func isOk = opt => opt
 T|> True
 F|> False

type Result E A -> Bool
func isErr = opt => opt
 F|> True
 T|> False

type (E1 -> E2) -> (Result E1 A) -> (Result E2 A)
func mapErr = transform opt => opt
 T|> keepOk
 F|> mapError transform

type A -> (Result E A) -> A
func withDefault = fallback opt => opt
 ||> Ok item -> item
 ||> Err _   -> fallback

type Result E A -> (Result E A) -> (Result E A)
func orElse = fallback opt => opt
 ||> Ok item -> Ok item
 ||> Err _   -> fallback

type (A -> Result E B) -> (Result E A) -> (Result E B)
func flatMap = next opt => opt
 T|> next
 F|> keepErr

type Result E (Result E A) -> (Result E A)
func flatten = opt => opt
 ||> Ok nested -> nested
 ||> Err error -> Err error

type Result E A -> (Option A)
func toOption = opt => opt
 T|> keepSome
 F|> None

type Result E A -> (List A)
func toList = opt => opt
 T|> singleton
 F|> []

type (A -> B) -> (Result E A) -> (Result E B)
func map = transform opt => opt
 ||> Err e   -> Err e
 ||> Ok item -> Ok (transform item)

type (E1 -> E2) -> (A -> B) -> (Result E1 A) -> (Result E2 B)
func mapBoth = onErr onOk opt => opt
 ||> Err e   -> Err (onErr e)
 ||> Ok item -> Ok (onOk item)

type (E -> B) -> (A -> B) -> (Result E A) -> B
func fold = onErr onOk opt => opt
 ||> Err e   -> onErr e
 ||> Ok item -> onOk item

type E -> (Option A) -> (Result E A)
func fromOption = error opt => opt
 ||> Some item -> Ok item
 ||> None      -> Err error

type Int -> Int
func incrementForTest = n =>
    n + 1

type Text -> Text
func prefixForTest = text =>
    append "error: " text

type Int -> Result Text Int
func incrementOkForTest = n =>
    Ok (n + 1)

type Text -> Text
func keepErrorForTest = text =>
    text

@test
value result_isOk : Task Text Bool = pure (isOk (Ok 2))

@test
value result_isErr : Task Text Bool = pure (isErr (Err "bad"))

@test
value result_mapErr : Task Text Bool = pure (mapErr prefixForTest (Err "bad") == Err "error: bad")

@test
value result_withDefault : Task Text Bool = pure (withDefault 0 (Ok 2) == 2)

@test
value result_orElse : Task Text Bool = pure (orElse (Ok 3) (Err "bad") == Ok 3)

@test
value result_flatMap : Task Text Bool = pure (flatMap incrementOkForTest (Ok 2) == Ok 3)

@test
value result_flatten : Task Text Bool = pure (flatten (Ok (Ok 2)) == Ok 2)

@test
value result_toOption : Task Text Bool = pure (toOption (Ok 2) == Some 2)

@test
value result_toList : Task Text Bool = pure (toList (Ok 2) == [2])

@test
value result_map : Task Text Bool = pure (map incrementForTest (Ok 2) == Ok 3)

@test
value result_mapBoth : Task Text Bool = pure (mapBoth prefixForTest incrementForTest (Ok 2) == Ok 3)

@test
value result_fold : Task Text Bool = pure (fold keepErrorForTest incrementForTest (Ok 2) == 3)

@test
value result_fromOption : Task Text Bool = pure (fromOption "bad" (Some 2) == Ok 2)

export isOk
export isErr
export mapErr
export withDefault
export orElse
export flatMap
export flatten
export toOption
export toList
export map
export mapBoth
export fold
export fromOption
