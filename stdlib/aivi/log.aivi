type LogLevel =
  | Debug
  | Info
  | Warn
  | Error
  | Fatal

type LogContext = (
    List (
        Text,
        Text
    )
)

type LogEntry = {
    level: LogLevel,
    message: Text,
    context: LogContext
}

type LogError = Text

type LogSource = Unit

type LogSink = (LogEntry -> (Task LogError Unit))

value levelDebug : Text = "DEBUG"
value levelInfo : Text = "INFO"
value levelWarn : Text = "WARN"
value levelError : Text = "ERROR"
value levelFatal : Text = "FATAL"

type LogLevel -> Text
func levelToText = level => level
 ||> Debug -> "DEBUG"
 ||> Info  -> "INFO"
 ||> Warn  -> "WARN"
 ||> Error -> "ERROR"
 ||> Fatal -> "FATAL"

type Text -> Text -> (Text, Text)
func kv = k v =>
    (k, v)

export (LogLevel, Debug, Info, Warn, Error, Fatal, LogContext, LogEntry, LogError, LogSource, LogSink, levelDebug, levelInfo, levelWarn, levelError, levelFatal, levelToText, kv)

@test
value log_levelToText : Task Text Bool = pure (levelToText Warn == "WARN")

@test
value log_kv : Task Text Bool = pure (kv "request" "42" == ("request", "42"))
