use aivi.path (
    parent
    filename
    stem
    extension
    join
    isAbsolute
    normalize
)

type PathSource = Unit

type PathError =
  | InvalidPath Text
  | PathNotFound Text

domain Path over Text = {
    type wrapPath : Text -> Path
    wrapPath = text => text

    type pathText : Path -> Text
    pathText = path => path
}

@test
value path_parent : Task Text Bool = pure (parent "/tmp/a.txt" == Some "/tmp")

@test
value path_filename : Task Text Bool = pure (filename "/tmp/a.txt" == Some "a.txt")

@test
value path_stem : Task Text Bool = pure (stem "/tmp/a.txt" == Some "a")

@test
value path_extension : Task Text Bool = pure (extension "/tmp/a.txt" == Some "txt")

@test
value path_join : Task Text Bool = pure (join "/tmp" "a.txt" == "/tmp/a.txt")

@test
value path_isAbsolute : Task Text Bool = pure (isAbsolute "/tmp/a.txt")

@test
value path_normalize : Task Text Bool = pure (normalize "/tmp/../var/./a" == "/var/a")

@test
value path_normalize_preserves_relative_parent : Task Text Bool = pure (normalize "../a" == "../a")

export (PathSource, Path, PathError, InvalidPath, PathNotFound, parent, filename, stem, extension, join, isAbsolute, normalize)
