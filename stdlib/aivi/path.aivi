use aivi.text (contains as textContains)

use aivi.path (
    parent
    filename
    stem
    extension
    join
    isAbsolute
    normalize
)

type PathSource = Unit

type PathError =
  | InvalidPath Text
  | PathNotFound Text

domain Path over Text = {
    type wrapPath : Text -> Path
    wrapPath = text => text

    type pathText : Path -> Text
    pathText = path => path
}

type Text -> Bool
func pathTextHasNul = text =>
    textContains "\0" text

// Parsing is lexical. Existence and permissions belong to filesystem tasks.
type Text -> Result PathError Path
func parse = text => pathTextHasNul text
 T|> Err (InvalidPath "path contains a NUL character")
 F|> Ok (wrapPath text)

type Path -> Text
func toText = path =>
    pathText path

type Text -> Bool
func hasExtension = path => extension path
 T|> True
 F|> False

type Text -> Bool
func isRelative = path => isAbsolute path
 T|> False
 F|> True

@test
value has_extension_for_dotted : Task Text Bool = pure (hasExtension "foo.txt")

@test
value is_relative_for_local : Task Text Bool = pure (isRelative "foo/bar.txt")

export (PathSource, Path, PathError, InvalidPath, PathNotFound, parent, filename, stem, extension, join, isAbsolute, normalize, hasExtension, isRelative)
export parse
export toText
