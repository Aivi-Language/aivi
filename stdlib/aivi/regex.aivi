use aivi.regex (
    isMatch
    find
    findText
    findAll
    replace
    replaceAll
)

// Type aliases for clarity
type Pattern = Text

type RegexError = Text

// Regex policy belongs to applications. The stdlib exposes only the six
// compiler-backed operations and does not guess at email or URL validity.
export (Pattern, RegexError, isMatch, find, findText, findAll, replace, replaceAll)
