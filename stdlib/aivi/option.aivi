hoist

type A -> Bool -> (Option A)
func filterHelp = item keep => keep
 T|> Some item
 F|> None

type A -> (Option B) -> (Option (A, B))
func zipHelp = a right => right
 ||> None   -> None
 ||> Some b -> Some (a, b)

type A -> (Option A)
func keepSome = item =>
    Some item

type A -> (List A)
func singleton = item =>
    [item]

type A -> (Result E A)
func okValue = item =>
    Ok item

type Option A -> Bool
func isSome = opt => opt
 T|> True
 F|> False

type Option A -> Bool
func isNone = opt => opt
 F|> True
 T|> False

type A -> (Option A) -> A
func getOrElse = fallback opt => opt
 ||> Some item -> item
 ||> None      -> fallback

type B -> (A -> B) -> (Option A) -> B
func fold = onNone onSome opt => opt
 ||> Some item -> onSome item
 ||> None      -> onNone

type B -> (A -> B) -> (Option A) -> B
func mapOr = fallback transform opt =>
    fold fallback transform opt

type (A -> Bool) -> (Option A) -> Bool
func isSomeAnd = predicate opt =>
    fold False predicate opt

type Option A -> (Option A) -> (Option A)
func orElse = fallback opt => opt
 T|> keepSome
 F|> fallback

type (A -> Option B) -> (Option A) -> (Option B)
func flatMap = next opt => opt
 T|> next
 F|> None

type Option (Option A) -> (Option A)
func flatten = opt => opt
 ||> Some nested -> nested
 ||> None        -> None

type Option A -> (List A)
func toList = opt => opt
 T|> singleton
 F|> []

type E -> (Option A) -> (Result E A)
func toResult = error opt => opt
 T|> okValue
 F|> Err error

type (A -> B) -> (Option A) -> (Option B)
func map = transform opt => opt
 ||> Some item -> Some (transform item)
 ||> None      -> None

type (A -> Bool) -> (Option A) -> (Option A)
func filter = predicate opt => opt
 ||> None      -> None
 ||> Some item -> filterHelp item (predicate item)

type Option A -> (Option B) -> (Option (A, B))
func zip = left right => left
 ||> None   -> None
 ||> Some a -> zipHelp a right

type A -> Bool -> (Option A)
func fromBool = item b => b
 T|> Some item
 F|> None

type Int -> Int
func incrementForTest = n =>
    n + 1

type Int -> Bool
func positiveForTest = n =>
    n > 0

type Int -> Option Int
func incrementSomeForTest = n =>
    Some (n + 1)

@test
value option_isSome : Task Text Bool = pure (isSome (Some 1))

@test
value option_isNone : Task Text Bool = pure (isNone None)

@test
value option_getOrElse : Task Text Bool = pure (getOrElse 0 (Some 2) == 2)

@test
value option_fold : Task Text Bool = pure (fold 0 incrementForTest (Some 2) == 3)

@test
value option_mapOr : Task Text Bool = pure (mapOr 0 incrementForTest (Some 2) == 3)

@test
value option_isSomeAnd : Task Text Bool = pure (isSomeAnd positiveForTest (Some 2))

@test
value option_orElse : Task Text Bool = pure (orElse (Some 3) None == Some 3)

@test
value option_flatMap : Task Text Bool = pure (flatMap incrementSomeForTest (Some 2) == Some 3)

@test
value option_flatten : Task Text Bool = pure (flatten (Some (Some 2)) == Some 2)

@test
value option_toList : Task Text Bool = pure (toList (Some 2) == [2])

@test
value option_toResult : Task Text Bool = pure (toResult "missing" (Some 2) == Ok 2)

@test
value option_map : Task Text Bool = pure (map incrementForTest (Some 2) == Some 3)

@test
value option_filter : Task Text Bool = pure (filter positiveForTest (Some 2) == Some 2)

@test
value option_zip : Task Text Bool = pure (zip (Some 2) (Some 3) == Some (2, 3))

@test
value option_fromBool : Task Text Bool = pure (fromBool 2 True == Some 2)

export isSome
export isNone
export getOrElse
export fold
export mapOr
export isSomeAnd
export orElse
export flatMap
export flatten
export toList
export toResult
export map
export filter
export zip
export fromBool
