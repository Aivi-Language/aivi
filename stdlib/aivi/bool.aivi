hoist

type Bool -> Bool
func not = b => b
 T|> False
 F|> True

type Bool -> Bool -> Bool
func xor = a b => a == b
 T|> False
 F|> True

type Bool -> Bool -> Bool
func implies = a b => a
 T|> b
 F|> True

type Bool -> Bool -> Bool
func both = a b =>
    a and b

type Bool -> Bool -> Bool
func either = a b =>
    a or b

type Bool -> Bool -> Bool
func neither = a b =>
    not a and not b

type Int -> Bool
func fromInt = n =>
    n != 0

@test
value not_flips_false : Task Text Bool = pure (not False)

@test
value both_accepts_true_pair : Task Text Bool = pure (both True True)

@test
value xor_accepts_exactly_one_true : Task Text Bool = pure (xor True False)

@test
value implies_rejects_true_to_false : Task Text Bool = pure (not (implies True False))

@test
value either_accepts_one_true : Task Text Bool = pure (either False True)

@test
value neither_accepts_two_false : Task Text Bool = pure (neither False False)

@test
value fromInt_treats_zero_as_false : Task Text Bool = pure (not (fromInt 0))

export not
export xor
export implies
export both
export either
export neither
export fromInt
