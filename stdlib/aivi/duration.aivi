hoist

use aivi.arithmetic (
    mul
    div
)

type DurationError = Text

domain Duration over Int = {
    suffix ms
    type ms : Int
    ms = n => Duration n

    suffix sec
    type sec : Int
    sec = n => Duration (mul n 1000)

    suffix min
    type min : Int
    min = n => Duration (mul n 60000)

    suffix hr
    type hr : Int
    hr = n => Duration (mul n 3600000)

    suffix dy
    type dy : Int
    dy = n => Duration (mul n 86400000)

    type millisValue : Int -> Duration
    millisValue = n => n

    type toMillisValue : Duration -> Int
    toMillisValue = duration => duration

    type toSecondsValue : Duration -> Int
    toSecondsValue = duration => div duration 1000

    type toMinutesValue : Duration -> Int
    toMinutesValue = duration => div duration 60000

    type toHoursValue : Duration -> Int
    toHoursValue = duration => div duration 3600000

    type toDaysValue : Duration -> Int
    toDaysValue = duration => div duration 86400000

    type trySecondsValue : Int -> Result DurationError Duration
    trySecondsValue = seconds =>
        seconds < 0 or seconds > 9223372036854775
        T|> Err "seconds are outside the supported duration range"
        F|> Ok (mul seconds 1000)

    type (+) : Duration -> Duration -> Duration
    (+) = left right => left + right

    type (-) : Duration -> Duration -> Duration
    (-) = left right => left - right

    type (*) : Duration -> Int -> Duration
    (*) = duration n => mul duration n

    type (<) : Duration -> Duration -> Bool
    (<) = left right => left < right
}

export DurationError
export Duration

// Public functions delegate to the domain's carrier-aware implementation.
type Int -> Duration
func millis = value =>
    millisValue value

export millis

type Duration -> Int
func toMillis = value =>
    toMillisValue value

export toMillis

type Duration -> Int
func toSeconds = value =>
    toSecondsValue value

export toSeconds

type Duration -> Int
func toMinutes = value =>
    toMinutesValue value

export toMinutes

type Duration -> Int
func toHours = value =>
    toHoursValue value

export toHours

type Duration -> Int
func toDays = value =>
    toDaysValue value

export toDays

type Int -> Result DurationError Duration
func trySeconds = value =>
    trySecondsValue value

export trySeconds
