// Keep the prelude carrier-agnostic. Data-specific helpers live in their
// owning modules so imports identify the operation's implementation owner.
export (Int, Float, Decimal, BigInt, Bool, Text, Unit, Ordering, List, Option, Result, Validation, Signal, Task, Eq, Default, Functor, Ord, Semigroup, Monoid, Bifunctor, Traversable, Filterable, Apply, Applicative, Chain, Monad, Foldable, min, max, minOf, maxOf, clamp)

@test
value prelude_min : Task Text Bool = pure (min 3 2 == 2)

@test
value prelude_max : Task Text Bool = pure (max 3 2 == 3)

@test
value prelude_minOf : Task Text Bool = pure (minOf 3 [2, 4] == 2)

@test
value prelude_maxOf : Task Text Bool = pure (maxOf 3 [2, 4] == 4)

@test
value prelude_clamp : Task Text Bool = pure (clamp 1 3 5 == 3)
