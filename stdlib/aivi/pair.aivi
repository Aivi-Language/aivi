hoist

type (A, B) -> A
func first = pair => pair
 ||> (a, _) -> a

type (A, B) -> B
func second = pair => pair
 ||> (_, b) -> b

type (A, B) -> (B, A)
func swap = pair => pair
 ||> (a, b) -> (b, a)

type (A -> C) -> (A, B) -> (C, B)
func mapFirst = transform pair => pair
 ||> (a, b) -> (transform a, b)

type (B -> C) -> (A, B) -> (A, C)
func mapSecond = transform pair => pair
 ||> (a, b) -> (a, transform b)

type (A -> C) -> (B -> D) -> (A, B) -> (C, D)
func mapBoth = transformFst transformSnd pair => pair
 ||> (a, b) -> (transformFst a, transformSnd b)

type A -> B -> (A, B)
func toPair = a b =>
    (a, b)

type A -> (A, A)
func duplicate = item =>
    (item, item)

type Int -> Int
func increment = n =>
    n + 1

type Text -> Text
func appendBang = text =>
    "{text}!"

@test
value first_returns_left_item : Task Text Bool = pure (first (42, "Ada") == 42)

@test
value second_returns_right_item : Task Text Bool = pure (second (42, "Ada") == "Ada")

@test
value mapFirst_transforms_only_left_item : Task Text Bool = pure (mapFirst increment (41, "Ada") == (42, "Ada"))

@test
value mapSecond_transforms_only_right_item : Task Text Bool = pure (mapSecond appendBang (42, "Ada") == (42, "Ada!"))

@test
value swap_reverses_pair : Task Text Bool = pure (swap (42, "Ada") == ("Ada", 42))

@test
value mapBoth_transforms_both_items : Task Text Bool = pure (mapBoth increment appendBang (41, "Ada") == (42, "Ada!"))

@test
value toPair_constructs_pair : Task Text Bool = pure (toPair 42 "Ada" == (42, "Ada"))

@test
value duplicate_copies_item : Task Text Bool = pure (duplicate 42 == (42, 42))

export first
export second
export swap
export mapFirst
export mapSecond
export mapBoth
export toPair
export duplicate
