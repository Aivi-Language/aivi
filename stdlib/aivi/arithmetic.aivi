use aivi.arithmetic (
    add
    sub
    mul
    div
    mod
    neg
)

// These compiler intrinsics are the complete public surface. Keeping their
// canonical names avoids a second wrapper vocabulary for ordinary arithmetic.
@test
value add_combines_integers : Task Text Bool = pure (add 20 22 == 42)

@test
value sub_subtracts_integers : Task Text Bool = pure (sub 50 8 == 42)

@test
value mul_multiplies_integers : Task Text Bool = pure (mul 6 7 == 42)

@test
value div_divides_integers : Task Text Bool = pure (div 84 2 == 42)

@test
value mod_returns_remainder : Task Text Bool = pure (mod 44 2 == 0)

@test
value neg_negates_integer : Task Text Bool = pure (neg 42 == -42)

export (add, sub, mul, div, mod, neg)
