use aivi.url (parseText)

use aivi.result (map)

type UrlError = Text

domain Url over Text = {
    type wrapUrl : Text -> Url
    wrapUrl = text => text

    type urlText : Url -> Text
    urlText = url => url
}

type Text -> Result UrlError Url
func parse = text =>
    map wrapUrl (parseText text)

type Url -> Text
func toText = url =>
    urlText url

export UrlError
export Url
export parse
export toText

value normalizedUrlForTest : Bool = parse "https://example.com/a/../b"
 ||> Err _    -> False
 ||> Ok value -> toText value == "https://example.com/b"

@test
value url_parse : Task Text Bool = pure normalizedUrlForTest

value urlTextForTest : Bool = parse "https://example.com/"
 ||> Err _    -> False
 ||> Ok value -> toText value == "https://example.com/"

@test
value url_toText : Task Text Bool = pure urlTextForTest

value relativeUrlForTest : Bool = parse "relative/path"
 ||> Err _ -> True
 ||> Ok _  -> False

@test
value url_parse_rejects_relative : Task Text Bool = pure relativeUrlForTest
