use aivi.url (parseText)

use aivi.result (map)

type UrlError = Text

domain Url over Text = {
    type wrapUrl : Text -> Url
    wrapUrl = text => text

    type urlText : Url -> Text
    urlText = url => url
}

type Text -> Result UrlError Url
func parse = text =>
    map wrapUrl (parseText text)

type Url -> Text
func toText = url =>
    urlText url

export UrlError
export Url
export parse
export toText
