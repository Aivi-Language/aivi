hoist

type AsyncTracker E A = {
    pending: Bool,
    done: Option A,
    error: Option E
}

type Result E A -> AsyncTracker E A -> AsyncTracker E A
func step = result current => result
 ||> Ok a  -> { pending: False, done: Some a, error: None }
 ||> Err e -> { pending: False, done: current.done, error: Some e }

type AsyncTracker E A -> Bool
func isPending = tracker =>
    tracker.pending

type AsyncTracker E A -> Bool
func isDone = tracker => tracker.done
 ||> None   -> False
 ||> Some _ -> True

type AsyncTracker E A -> Bool
func isFailed = tracker => tracker.error
 ||> None   -> False
 ||> Some _ -> True

export (AsyncTracker, step, isPending, isDone, isFailed)

value pendingTrackerForTest : AsyncTracker Text Int = {
    pending: True,
    done: None,
    error: None
}

value doneTrackerForTest : AsyncTracker Text Int = step (Ok 3) pendingTrackerForTest
value failedTrackerForTest : AsyncTracker Text Int = step (Err "offline") doneTrackerForTest

@test
value async_step : Task Text Bool = pure (isDone (step (Ok 3) pendingTrackerForTest))

@test
value async_isPending : Task Text Bool = pure (isPending pendingTrackerForTest)

@test
value async_isDone : Task Text Bool = pure (isDone doneTrackerForTest)

@test
value async_isFailed : Task Text Bool = pure (isFailed failedTrackerForTest)

@test
value async_preserves_last_success_after_failure : Task Text Bool = pure (failedTrackerForTest.done == Some 3 and failedTrackerForTest.error == Some "offline")
