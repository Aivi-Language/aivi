use aivi.arithmetic (
    add
    sub
)

use aivi.core.float (
    fromInt as floatFromInt
    toInt as floatToInt
)

domain Px over Int = {
    type mkPx : Int -> Px
    mkPx = n => n

    type carry : Px -> Int
    carry = p => p

    type geqPx : Px -> Px -> Bool
    geqPx = a b => a >= b

    type leqPx : Px -> Px -> Bool
    leqPx = a b => a <= b
}

type Int -> Px
func px = n =>
    mkPx n

value zero : Px = mkPx 0

type Px -> Px -> Px
func addPx = a b =>
    mkPx (add (carry a) (carry b))

type Px -> Px -> Px
func subPx = a b =>
    mkPx (sub (carry a) (carry b))

type Px -> Float -> Px
func scalePx = a f =>
    mkPx (floatToInt (floatFromInt (carry a) * f))

type Px -> Px -> Px
func maxPx = a b => geqPx a b
 T|> a
 F|> b

type Px -> Px -> Px
func minPx = a b => leqPx a b
 T|> a
 F|> b

export Px
export px
export zero
export addPx
export subPx
export scalePx
export maxPx
export minPx

@test
value px_constructs : Task Text Bool = pure (px 8 == px 8)

@test
value px_addPx : Task Text Bool = pure (addPx (px 8) (px 4) == px 12)

@test
value px_subPx : Task Text Bool = pure (subPx (px 8) (px 3) == px 5)

@test
value px_scalePx : Task Text Bool = pure (scalePx (px 8) 0.5 == px 4)

@test
value px_maxPx : Task Text Bool = pure (maxPx (px 8) (px 12) == px 12)

@test
value px_minPx : Task Text Bool = pure (minPx (px 8) (px 12) == px 8)
