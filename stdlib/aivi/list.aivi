hoist

type TailState A = {
    seenFirst: Bool,
    items: List A
}

type Partition A = {
    matched: List A,
    unmatched: List A
}

type ReduceWithIndexState A B = {
    index: Int,
    value: B
}

type A -> (Option A)
func keepSome = item =>
    Some item

type Option A -> A -> (Option A)
func keepFirst = found item => found
 T|> keepSome
 F|> Some item

type List A -> A -> Bool -> (TailState A)
func tailState = items item seenFirst => seenFirst
 T|> { seenFirst: True, items: append items [item] }
 F|> { seenFirst: True, items: [] }

type TailState A -> A -> (TailState A)
func tailStep = state item => state
 ||> { seenFirst, items } -> tailState items item seenFirst

type List A -> Bool -> (Option (List A))
func tailItems = items seenFirst => seenFirst
 T|> Some items
 F|> None

type TailState A -> (Option (List A))
func tailFromState = state => state
 ||> { seenFirst, items } -> tailItems items seenFirst

type Option A -> A -> (Option A)
func takeLast = current item =>
    Some item

type Int -> A -> Int
func lengthStep = total item =>
    total + 1

type (A -> Bool) -> Bool -> A -> Bool
func anyStep = predicate found item => found
 T|> True
 F|> predicate item

type (A -> Bool) -> Bool -> A -> Bool
func allStep = predicate allMatched item => allMatched
 T|> predicate item
 F|> False

type (A -> Bool) -> Int -> A -> Int
func countStep = predicate total item => predicate item
 T|> total + 1
 F|> total

type (A -> Bool) -> A -> (Option A)
func selectMatch = predicate item => predicate item
 T|> Some item
 F|> None

type (A -> Bool) -> (Option A) -> A -> (Option A)
func findStep = predicate found item => found
 T|> keepSome
 F|> selectMatch predicate item

type (A -> Option B) -> (Option B) -> A -> (Option B)
func findMapStep = transform found item => found
 T|> keepSome
 F|> transform item

type List A -> (List A) -> A -> Bool -> (Partition A)
func partitionItems = matched unmatched item isMatch => isMatch
 T|> { matched: append matched [item], unmatched }
 F|> { matched, unmatched: append unmatched [item] }

type (A -> Bool) -> (Partition A) -> A -> (Partition A)
func partitionStep = predicate state item => state
 ||> { matched, unmatched } -> partitionItems matched unmatched item (predicate item)

type List A -> (List A)
func tailOrEmpty = items => tail items
 ||> Some remaining -> remaining
 ||> None           -> []

type List A -> Bool
func isEmpty = items => head items
 F|> True
 T|> False

type List A -> Bool
func nonEmpty = items => head items
 T|> True
 F|> False

type AtState A = {
    remaining: Int,
    found: Option A
}

type AtState A -> A -> (AtState A)
func atStep = state item => state.found
 T|> state
 F|> atMissing state item

type AtState A -> A -> (AtState A)
func atMissing = state item => state.remaining == 0
 T|> { remaining: -1, found: Some item }
 F|> { remaining: state.remaining - 1, found: None }

type List A -> Int
func length = items => items
  |> reduce lengthStep 0

type List A -> (Option A)
func head = items => items
  |> reduce keepFirst None

type Int -> (List A) -> (Option A)
func at = index items => index < 0
 T|> None
 F|> atNonNegative index items

type Int -> (List A) -> (Option A)
func atNonNegative = index items => items
  |> reduce atStep { remaining: index, found: None }
  |> .found

type List A -> (Option (List A))
func tail = items => items
  |> reduce tailStep { seenFirst: False, items: [] }
  |> tailFromState

type List A -> (Option A)
func last = items => items
  |> reduce takeLast None

type List A -> (List B) -> (List (A, B))
func zip = left right =>
    zipWith pairForZip left right

type A -> B -> (A, B)
func pairForZip = left right =>
    (left, right)

type (A -> Bool) -> (List A) -> Bool
func any = predicate items => items
  |> reduce (anyStep predicate) False

type (A -> Bool) -> (List A) -> Bool
func all = predicate items => items
  |> reduce (allStep predicate) True

type (A -> Bool) -> (List A) -> Int
func count = predicate items => items
  |> reduce (countStep predicate) 0

type (A -> Bool) -> (List A) -> (Option A)
func find = predicate items => items
  |> reduce (findStep predicate) None

type (A -> Option B) -> (List A) -> (Option B)
func findMap = transform items => items
  |> reduce (findMapStep transform) None

type (A -> Bool) -> (List A) -> (Partition A)
func partition = predicate items => items
  |> reduce (partitionStep predicate) { matched: [], unmatched: [] }

type ReplaceAtState A = {
    remaining: Int,
    replaced: Bool,
    items: List A
}

type A -> (ReplaceAtState A) -> A -> (ReplaceAtState A)
func replaceAtStep = replacement state item => (state.replaced, state.remaining == 0)
 ||> (True, _)      -> { remaining: state.remaining, replaced: True, items: append state.items [item] }
 ||> (False, True)  -> { remaining: -1, replaced: True, items: append state.items [replacement] }
 ||> (False, False) -> { remaining: state.remaining - 1, replaced: False, items: append state.items [item] }

type Int -> A -> (List A) -> (List A)
func replaceAt = index replacement items => index < 0
 T|> items
 F|> items
  |> reduce (replaceAtStep replacement) { remaining: index, replaced: False, items: [] }
  |> .items

type (A -> B) -> (List B) -> A -> (List B)
func mapStep = transform acc item =>
    append acc [transform item]

type (A -> B) -> (List A) -> (List B)
func map = transform items => items
  |> reduce (mapStep transform) []

type (B -> Int -> A -> B) -> (ReduceWithIndexState A B) -> A -> (ReduceWithIndexState A B)
func reduceWithIndexStep = step state item =>
    {
        index: state.index + 1,
        value: step state.value state.index item
    }

type (B -> Int -> A -> B) -> B -> (List A) -> B
func reduceWithIndex = step seed items => items
  |> reduce (reduceWithIndexStep step) { index: 0, value: seed }
  |> .value

type Int -> A -> (Int, A)
func pairWithIndex = index item =>
    (index, item)

type (Int -> A -> B) -> (List B) -> Int -> A -> (List B)
func mapWithIndexStep = transform acc index item =>
    append acc [
        transform index item
    ]

type (Int -> A -> B) -> (List A) -> (List B)
func mapWithIndex = transform items =>
    reduceWithIndex (mapWithIndexStep transform) [] items

type List A -> (List (Int, A))
func indexed = items =>
    mapWithIndex pairWithIndex items

type (A -> Option B) -> (List B) -> A -> (List B)
func filterMapStep = transform acc item => transform item
 ||> Some mapped -> append acc [mapped]
 ||> None        -> acc

type (A -> Option B) -> (List A) -> (List B)
func filterMap = transform items => items
  |> reduce (filterMapStep transform) []

type (A -> Bool) -> (List A) -> A -> (List A)
func filterStep = predicate acc item => predicate item
 T|> append acc [item]
 F|> acc

type (A -> Bool) -> (List A) -> (List A)
func filter = predicate items => items
  |> reduce (filterStep predicate) []

type List A -> (List A) -> (List A)
func flattenStep = acc inner =>
    append acc inner

type List (List A) -> (List A)
func flatten = xss => xss
  |> reduce flattenStep []

type (A -> List B) -> (List B) -> A -> (List B)
func flatMapStep = transform acc item =>
    append acc (transform item)

type (A -> List B) -> (List A) -> (List B)
func flatMap = transform items => items
  |> reduce (flatMapStep transform) []

type List A -> A -> (List A)
func reverseStep = acc item =>
    append [item] acc

type List A -> (List A)
func reverse = items => items
  |> reduce reverseStep []

type TakeState A = {
    remaining: Int,
    items: List A
}

type DropState A = {
    remaining: Int,
    items: List A
}

type TakeState A -> A -> (TakeState A)
func takeStep = state item => state.remaining > 0
 T|> { remaining: state.remaining - 1, items: append state.items [item] }
 F|> state

type Int -> (List A) -> (List A)
func take = n items => items
  |> reduce takeStep { remaining: n, items: [] }
  |> .items

type DropState A -> A -> (DropState A)
func dropStep = state item => state.remaining > 0
 T|> { remaining: state.remaining - 1, items: state.items }
 F|> { remaining: 0, items: append state.items [item] }

type Int -> (List A) -> (List A)
func drop = n items => items
  |> reduce dropStep { remaining: n, items: [] }
  |> .items

type TakeWhileState A = {
    taking: Bool,
    items: List A
}

type DropWhileState A = {
    taking: Bool,
    items: List A
}

type TakeWhileState A -> A -> Bool -> (TakeWhileState A)
func applyTakeWhile = state item matches => matches
 T|> { taking: True, items: append state.items [item] }
 F|> { taking: False, items: state.items }

type (A -> Bool) -> (TakeWhileState A) -> A -> (TakeWhileState A)
func takeWhileStep = predicate state item => state.taking
 T|> applyTakeWhile state item (predicate item)
 F|> state

type (A -> Bool) -> (List A) -> (List A)
func takeWhile = predicate items => items
  |> reduce (takeWhileStep predicate) { taking: True, items: [] }
  |> .items

type DropWhileState A -> A -> Bool -> (DropWhileState A)
func applyDropWhile = state item matches => matches
 T|> state
 F|> { taking: False, items: [item] }

type (A -> Bool) -> (DropWhileState A) -> A -> (DropWhileState A)
func dropWhileStep = predicate state item => state.taking
 T|> applyDropWhile state item (predicate item)
 F|> { taking: False, items: append state.items [item] }

type (A -> Bool) -> (List A) -> (List A)
func dropWhile = predicate items => items
  |> reduce (dropWhileStep predicate) { taking: True, items: [] }
  |> .items

type Int -> Int -> Int
func sumStep = acc item =>
    acc + item

type Int -> Int -> Int
func productStep = acc item =>
    acc * item

type List Int -> Int
func sum = items => items
  |> reduce sumStep 0

type List Int -> Int
func product = items => items
  |> reduce productStep 1

type (A -> A -> Bool) -> A -> A -> A
func chooseGreaterBy = compare best item => compare best item
 T|> item
 F|> best

type (A -> A -> Bool) -> A -> A -> A
func chooseLesserBy = compare best item => compare item best
 T|> item
 F|> best

type (A -> A -> Bool) -> (List A) -> (Option A)
func maximumBy = compare items => head items
 ||> None       -> None
 ||> Some first -> Some (reduce (chooseGreaterBy compare) first (tailOrEmpty items))

type (A -> A -> Bool) -> (List A) -> (Option A)
func minimumBy = compare items => head items
 ||> None       -> None
 ||> Some first -> Some (reduce (chooseLesserBy compare) first (tailOrEmpty items))

type Eq A => A -> Bool -> A -> Bool
func containsStep = target found item => found
 T|> True
 F|> item == target

type Eq A => A -> (List A) -> Bool
func contains = target items => items
  |> reduce (containsStep target) False

type IndexState A = {
    index: Int,
    found: Option Int
}

type IndexState A -> A -> Bool -> (IndexState A)
func indexFoundResult = state item predResult => predResult
 T|> { index: state.index + 1, found: Some state.index }
 F|> { index: state.index + 1, found: None }

type (A -> Bool) -> (IndexState A) -> A -> (IndexState A)
func indexOfStep = predicate state item => state.found
 ||> Some ignored -> state
 ||> None         -> indexFoundResult state item (predicate item)

type (A -> Bool) -> (List A) -> (Option Int)
func indexOf = predicate items => items
  |> reduce (indexOfStep predicate) { index: 0, found: None }
  |> .found

type IntersperseState A = {
    first: Bool,
    items: List A
}

type A -> (IntersperseState A) -> A -> (IntersperseState A)
func intersperseStep = sep state item => state.first
 T|> { first: False, items: [item] }
 F|> { first: False, items: append (append state.items [sep]) [item] }

type A -> (List A) -> (List A)
func intersperse = sep items => items
  |> reduce (intersperseStep sep) { first: True, items: [] }
  |> .items

type ZipWithState A B C = {
    remaining: List B,
    result: List C
}

type (A -> B -> C) -> (ZipWithState A B C) -> A -> (ZipWithState A B C)
func zipWithStep = combine state left => head state.remaining
 ||> None   -> state
 ||> Some r -> { remaining: tailOrEmpty state.remaining, result: append state.result [combine left r] }

type (A -> B -> C) -> (List A) -> (List B) -> (List C)
func zipWith = combine left right => left
  |> reduce (zipWithStep combine) { remaining: right, result: [] }
  |> .result

type UnzipState A B = {
    lefts: List A,
    rights: List B
}

type UnzipState A B -> (A, B) -> (UnzipState A B)
func unzipStep = state pair => pair
 ||> (left, right) -> { lefts: append state.lefts [left], rights: append state.rights [right] }

type UnzipState A B -> (List A, List B)
func finishUnzip = state =>
    (state.lefts, state.rights)

type List (A, B) -> (List A, List B)
func unzip = pairs => pairs
  |> reduce unzipStep { lefts: [], rights: [] }
  |> finishUnzip

type (A -> A -> Bool) -> (List A) -> A -> (List A)
func uniqueByStep = eq acc item => any (eq item) acc
 T|> acc
 F|> append acc [item]

type (A -> A -> Bool) -> (List A) -> (List A)
func uniqueBy = eq items => items
  |> reduce (uniqueByStep eq) []

type InsertState A = {
    inserted: Bool,
    items: List A
}

type A -> (InsertState A) -> (List A)
func finalizeSortInsert = item state => state.inserted
 T|> state.items
 F|> append state.items [item]

type InsertState A -> A -> A -> (InsertState A)
func doInsertBefore = state item current =>
    {
        inserted: True,
        items: append (append state.items [item]) [current]
    }

type InsertState A -> A -> (InsertState A)
func doSkipInsert = state current =>
    {
        inserted: False,
        items: append state.items [current]
    }

type (A -> A -> Bool) -> A -> (InsertState A) -> A -> (InsertState A)
func insertByStep = compare item state current => state.inserted
 T|> { inserted: True, items: append state.items [current] }
 F|> insertByCheckOrder compare item state current

type (A -> A -> Bool) -> A -> (InsertState A) -> A -> (InsertState A)
func insertByCheckOrder = compare item state current => compare item current
 T|> doInsertBefore state item current
 F|> doSkipInsert state current

type (A -> A -> Bool) -> A -> (List A) -> (List A)
func insertSortedBy = compare item sorted => sorted
  |> reduce (insertByStep compare item) { inserted: False, items: [] }
  |> finalizeSortInsert item

type (A -> A -> Bool) -> (List A) -> A -> (List A)
func sortByStep = compare sorted item =>
    insertSortedBy compare item sorted

type (A -> A -> Bool) -> (List A) -> (List A)
func sortBy = compare items => items
  |> reduce (sortByStep compare) []

type Int -> Int
func incrementForTest = n =>
    n + 1

type Int -> Bool
func positiveForTest = n =>
    n > 0

type Int -> Bool
func belowThreeForTest = n =>
    n < 3

type Int -> Option Int
func keepEvenForTest = n => n % 2 == 0
 T|> Some n
 F|> None

type Int -> List Int
func duplicateForTest = n =>
    [n, n]

type Int -> Int -> Int
func addForTest = left right =>
    left + right

type Int -> Int -> Int
func addIndexForTest = index item =>
    index + item

type Int -> Int -> Int -> Int
func addIndexedForTest = total index item =>
    total + index + item

type Int -> Int -> Bool
func lessForTest = left right =>
    left < right

type Int -> Int -> Bool
func equalForTest = left right =>
    left == right

@test
value list_isEmpty : Task Text Bool = pure (isEmpty [])

@test
value list_nonEmpty : Task Text Bool =
    pure (
        nonEmpty [
            1
        ]
    )

@test
value list_length : Task Text Bool = pure (length [1, 2, 3] == 3)

@test
value list_head : Task Text Bool = pure (head [1, 2] == Some 1)

@test
value list_at : Task Text Bool = pure (at 1 [1, 2] == Some 2)

@test
value list_tail : Task Text Bool = pure (tail [1, 2] == Some [2])

@test
value list_tailOrEmpty : Task Text Bool = pure (tailOrEmpty [1, 2] == [2])

@test
value list_last : Task Text Bool = pure (last [1, 2] == Some 2)

@test
value list_map : Task Text Bool = pure (map incrementForTest [1, 2] == [2, 3])

@test
value list_mapWithIndex : Task Text Bool = pure (mapWithIndex addIndexForTest [10, 20] == [10, 21])

@test
value list_reduceWithIndex : Task Text Bool = pure (reduceWithIndex addIndexedForTest 0 [10, 20] == 31)

@test
value list_indexed : Task Text Bool = pure (indexed [10, 20] == [(0, 10), (1, 20)])

@test
value list_replaceAt : Task Text Bool = pure (replaceAt 1 9 [1, 2, 3] == [1, 9, 3])

@test
value list_filter : Task Text Bool = pure (filter positiveForTest [-1, 0, 1] == [1])

@test
value list_filterMap : Task Text Bool = pure (filterMap keepEvenForTest [1, 2, 3, 4] == [2, 4])

@test
value list_flatten : Task Text Bool = pure (flatten [[1, 2], [3]] == [1, 2, 3])

@test
value list_flatMap : Task Text Bool = pure (flatMap duplicateForTest [1, 2] == [1, 1, 2, 2])

@test
value list_reverse : Task Text Bool = pure (reverse [1, 2, 3] == [3, 2, 1])

@test
value list_take : Task Text Bool = pure (take 2 [1, 2, 3] == [1, 2])

@test
value list_drop : Task Text Bool = pure (drop 2 [1, 2, 3] == [3])

@test
value list_takeWhile : Task Text Bool = pure (takeWhile belowThreeForTest [1, 2, 3] == [1, 2])

@test
value list_dropWhile : Task Text Bool = pure (dropWhile belowThreeForTest [1, 2, 3] == [3])

@test
value list_sum : Task Text Bool = pure (sum [1, 2, 3] == 6)

@test
value list_product : Task Text Bool = pure (product [2, 3, 4] == 24)

@test
value list_maximumBy : Task Text Bool = pure (maximumBy lessForTest [1, 3, 2] == Some 3)

@test
value list_minimumBy : Task Text Bool = pure (minimumBy lessForTest [1, 3, 2] == Some 1)

@test
value list_maximum : Task Text Bool = pure (maximum [1, 3, 2] == Some 3)

@test
value list_minimum : Task Text Bool = pure (minimum [1, 3, 2] == Some 1)

@test
value list_contains : Task Text Bool =
    pure (
        contains 2 [
            1,
            2,
            3
        ]
    )

@test
value list_indexOf : Task Text Bool = pure (indexOf belowThreeForTest [3, 2, 1] == Some 1)

@test
value list_intersperse : Task Text Bool = pure (intersperse 0 [1, 2, 3] == [1, 0, 2, 0, 3])

@test
value list_zip : Task Text Bool = pure (zip [1, 2] [3, 4] == [(1, 3), (2, 4)])

@test
value list_zipWith : Task Text Bool = pure (zipWith addForTest [1, 2] [3, 4] == [4, 6])

@test
value list_unzip : Task Text Bool = pure (unzip [(1, 3), (2, 4)] == ([1, 2], [3, 4]))

@test
value list_uniqueBy : Task Text Bool = pure (uniqueBy equalForTest [1, 2, 1] == [1, 2])

@test
value list_unique : Task Text Bool = pure (unique [1, 2, 1] == [1, 2])

@test
value list_sortBy : Task Text Bool = pure (sortBy lessForTest [3, 1, 2] == [1, 2, 3])

@test
value list_sort : Task Text Bool = pure (sort [3, 1, 2] == [1, 2, 3])

@test
value list_any : Task Text Bool =
    pure (
        any positiveForTest [
            -1,
            1
        ]
    )

@test
value list_all : Task Text Bool =
    pure (
        all positiveForTest [
            1,
            2
        ]
    )

@test
value list_count : Task Text Bool = pure (count positiveForTest [-1, 1, 2] == 2)

@test
value list_find : Task Text Bool = pure (find positiveForTest [-1, 2, 3] == Some 2)

@test
value list_findMap : Task Text Bool = pure (findMap keepEvenForTest [1, 3, 4] == Some 4)

@test
value list_partition : Task Text Bool = pure ((partition positiveForTest [-1, 1, 2]).matched == [1, 2] and (partition positiveForTest [-1, 1, 2]).unmatched == [-1])

