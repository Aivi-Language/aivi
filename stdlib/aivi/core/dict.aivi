use aivi.list (
    filter
    find
    map
    length
)

type DictEntry K V = {
    key: K,
    value: V
}

type Dict K V = {
    entries: List (DictEntry K V)
}

type K -> V -> (DictEntry K V)
func entry = k v =>
    { key: k, value: v }

type K -> V -> (Dict K V)
func singleton = k v =>
    { entries: [entry k v] }

type Eq K => K -> (DictEntry K V) -> Bool
func matchesKey = k entry =>
    entry.key == k

type Eq K => K -> (DictEntry K V) -> Bool
func notMatchesKey = k entry => entry.key == k
 T|> False
 F|> True

type Eq K => K -> (Dict K V) -> (List (DictEntry K V))
func filterOldKey = k d => d.entries
  |> filter (notMatchesKey k)

type Eq K => K -> V -> (Dict K V) -> (Dict K V)
func insert = k v d =>
    {
        entries: append [entry k v] (filterOldKey k d)
    }

type Eq K => (V -> V -> V) -> K -> V -> (Dict K V) -> (Dict K V)
func insertWith = merge k v d => d.entries
  |> find (matchesKey k)
 ||> None          -> { entries: append d.entries [entry k v] }
 ||> Some existing -> insert k (merge existing.value v) d

type Eq K => K -> (Dict K V) -> (Option V)
func get = k d => d.entries
  |> find (matchesKey k)
 ||> None       -> None
 ||> Some entry -> Some entry.value

type Eq K => V -> K -> (Dict K V) -> V
func getWithDefault = default k d => d.entries
  |> find (matchesKey k)
 ||> None       -> default
 ||> Some entry -> entry.value

type Eq K => K -> (Dict K V) -> Bool
func member = k d => d.entries
  |> find (matchesKey k)
 ||> Some _ -> True
 ||> None   -> False

type Eq K => K -> (Dict K V) -> (Dict K V)
func remove = k d =>
    {
        entries: filterOldKey k d
    }

type Dict K V -> Int
func size = d => d.entries
  |> length

type DictEntry K V -> K
func extractKey = entry =>
    entry.key

type Dict K V -> (List K)
func keys = d => d.entries
  |> map extractKey

type DictEntry K V -> V
func extractValue = entry =>
    entry.value

type Dict K V -> (List V)
func values = d => d.entries
  |> map extractValue

type DictEntry K V -> ((K, V))
func toPair = entry =>
    (entry.key, entry.value)

type Dict K V -> (List (K, V))
func toList = d => d.entries
  |> map toPair

type Eq K => (Dict K V) -> (K, V) -> (Dict K V)
func insertPair = acc pair => pair
 ||> (k, v) -> insert k v acc

type Eq K => (List (K, V)) -> (Dict K V)
func fromList = items => items
  |> reduce insertPair { entries: [] }

type (V1 -> V2) -> (DictEntry K V1) -> (DictEntry K V2)
func mapEntryValue = f entry =>
    {
        key: entry.key,
        value: f entry.value
    }

type (V1 -> V2) -> (Dict K V1) -> (List (DictEntry K V2))
func mappedEntries = f d => d.entries
  |> map (mapEntryValue f)

type (V1 -> V2) -> (Dict K V1) -> (Dict K V2)
func mapValues = f d =>
    {
        entries: mappedEntries f d
    }

type (V -> Bool) -> (DictEntry K V) -> Bool
func entryMatchesPredicate = predicate entry =>
    predicate entry.value

type (V -> Bool) -> (Dict K V) -> (List (DictEntry K V))
func filteredValueEntries = predicate d => d.entries
  |> filter (entryMatchesPredicate predicate)

type (V -> Bool) -> (Dict K V) -> (Dict K V)
func filterValues = predicate d =>
    {
        entries: filteredValueEntries predicate d
    }

export Dict
export singleton
export insert
export insertWith
export get
export getWithDefault
export member
export remove
export size
export keys
export values
export toList
export fromList
export mapValues
export filterValues

type Int -> Int
func doubleForTest = value =>
    value * 2

type Int -> Bool
func positiveForTest = value =>
    value > 0

type Int -> Int -> Int
func addForTest = left right =>
    left + right

@test
value dict_singleton : Task Text Bool = pure (get "a" (singleton "a" 1) == Some 1)

@test
value dict_insert : Task Text Bool = pure (get "b" (insert "b" 2 (singleton "a" 1)) == Some 2)

@test
value dict_insert_replaces : Task Text Bool = pure (size (insert "a" 2 (singleton "a" 1)) == 1)

@test
value dict_insertWith : Task Text Bool = pure (get "a" (insertWith addForTest "a" 2 (singleton "a" 1)) == Some 3)

@test
value dict_get_missing : Task Text Bool = pure (get "z" (singleton "a" 1) == None)

@test
value dict_getWithDefault : Task Text Bool = pure (getWithDefault 7 "z" (singleton "a" 1) == 7)

@test
value dict_member : Task Text Bool = pure (member "a" (singleton "a" 1))

@test
value dict_remove : Task Text Bool = pure (size (remove "a" (singleton "a" 1)) == 0)

@test
value dict_size : Task Text Bool = pure (size (insert "b" 2 (singleton "a" 1)) == 2)

@test
value dict_keys : Task Text Bool = pure (keys (singleton "a" 1) == ["a"])

@test
value dict_values : Task Text Bool = pure (values (singleton "a" 1) == [1])

@test
value dict_toList : Task Text Bool = pure (toList (singleton "a" 1) == [("a", 1)])

@test
value dict_fromList : Task Text Bool = pure (get "b" (fromList [("a", 1), ("b", 2)]) == Some 2)

@test
value dict_mapValues : Task Text Bool = pure (get "a" (mapValues doubleForTest (singleton "a" 2)) == Some 4)

@test
value dict_filterValues : Task Text Bool = pure (size (filterValues positiveForTest (fromList [("a", 1), ("b", -1)])) == 1)

// Class operations preserve keys and entry order; only values are transformed.
instance Functor (Dict K) = {
    map = mapValues
}

instance Foldable (Dict K) = {
    reduce = step seed dictionary => reduce step seed (values dictionary)
}

type (A -> Option B) -> DictEntry K A -> Option (DictEntry K B)
func filterMapEntry = transform entry => transform entry.value
 ||> None       -> None
 ||> Some value -> Some { key: entry.key, value }

type (A -> Option B) -> Dict K A -> Dict K B
func filterMapValues = transform dictionary =>
    {
        entries: filterMap (filterMapEntry transform) dictionary.entries
    }

instance Filterable (Dict K) = {
    filterMap = filterMapValues
}

instance Default (Dict K V) = {
    default = { entries: [] }
}
