use aivi.core.float (
    floor
    abs
    round
    fromInt
    toInt
    ceil
    sqrt
    toText
    parseText
)

value pi : Float = 3.141592653589793
value e : Float = 2.718281828459045
value tau : Float = 6.283185307179586

type Float -> Float
func negate = n =>
    0.0 - n

type Float -> Float -> Float
func max = a b => a >= b
 T|> a
 F|> b

type Float -> Float -> Float
func min = a b => a <= b
 T|> a
 F|> b

type Float -> Float -> Float
func clampHigh = hi n => n > hi
 T|> hi
 F|> n

type Float -> Float -> Float -> Float
func clamp = lo hi n => n < lo
 T|> lo
 F|> clampHigh hi n

type Float -> Float -> Float -> Float
func lerp = a b t =>
    a + (b - a) * t

type Float -> Float
func signNonNeg = n => n > 0.0
 T|> 1.0
 F|> 0.0

type Float -> Float
func sign = n => n < 0.0
 T|> 0.0 - 1.0
 F|> signNonNeg n

type Float -> Float -> Float -> Bool
func between = lo hi n =>
    n >= lo and n <= hi

type Float -> Bool
func isZero = n =>
    n == 0.0

type Float -> Bool
func isPositive = n =>
    n > 0.0

type Float -> Bool
func isNegative = n =>
    n < 0.0

type Float -> Float
func square = n =>
    n * n

type Float -> Float
func toRadians = degrees =>
    degrees * pi / 180.0

type Float -> Float
func toDegrees = radians =>
    radians * 180.0 / pi

type Float -> Float -> Float -> Bool
func approxEq = epsilon a b =>
    abs (a - b) <= epsilon

@test
value float_pi : Task Text Bool = pure (approxEq 0.000001 pi 3.141592653589793)

@test
value float_e : Task Text Bool = pure (approxEq 0.000001 e 2.718281828459045)

@test
value float_tau : Task Text Bool = pure (approxEq 0.000001 tau (2.0 * pi))

@test
value float_negate : Task Text Bool = pure (negate 2.5 == -2.5)

@test
value float_max : Task Text Bool = pure (max 3.5 2.0 == 3.5)

@test
value float_min : Task Text Bool = pure (min 3.5 2.0 == 2.0)

@test
value float_clamp : Task Text Bool = pure (clamp 0.0 1.0 2.0 == 1.0)

@test
value float_lerp : Task Text Bool = pure (lerp 0.0 10.0 0.5 == 5.0)

@test
value float_sign : Task Text Bool = pure (sign (-2.0) == -1.0)

@test
value float_between : Task Text Bool = pure (between 0.0 1.0 0.5)

@test
value float_isZero : Task Text Bool = pure (isZero 0.0)

@test
value float_isPositive : Task Text Bool = pure (isPositive 1.0)

@test
value float_isNegative : Task Text Bool = pure (isNegative (-1.0))

@test
value float_square : Task Text Bool = pure (square 3.0 == 9.0)

@test
value float_toRadians : Task Text Bool = pure (approxEq 0.000001 (toRadians 180.0) pi)

@test
value float_toDegrees : Task Text Bool = pure (approxEq 0.000001 (toDegrees pi) 180.0)

@test
value float_floor : Task Text Bool = pure (floor 2.9 == 2.0)

@test
value float_ceil : Task Text Bool = pure (ceil 2.1 == 3.0)

@test
value float_round : Task Text Bool = pure (round 2.6 == 3.0)

@test
value float_sqrt : Task Text Bool = pure (sqrt 9.0 == 3.0)

@test
value float_abs : Task Text Bool = pure (abs (-2.5) == 2.5)

@test
value float_toInt : Task Text Bool = pure (toInt 3.9 == 3)

@test
value float_fromInt : Task Text Bool = pure (fromInt 3 == 3.0)

@test
value float_toText : Task Text Bool = pure (toText 2.5 == "2.5")

@test
value float_parseText : Task Text Bool = pure (parseText "2.5" == Some 2.5)

@test
value float_approxEq : Task Text Bool = pure (approxEq 0.01 1.0 1.005)

export pi
export e
export tau
export negate
export max
export min
export clamp
export lerp
export sign
export between
export isZero
export isPositive
export isNegative
export square
export toRadians
export toDegrees
export floor
export ceil
export round
export sqrt
export abs
export toInt
export fromInt
export toText
export parseText
export approxEq
