use aivi.core.bytes (
    empty
    length
    get
    slice
    append
    fromText
    toText
    repeat
)

type Bytes -> Bool
func isEmpty = b =>
    length b == 0

type Bytes -> Bool
func nonEmpty = b =>
    length b > 0

type Bytes -> Bytes -> Bytes
func concatStep = acc b =>
    append acc b

type List Bytes -> Bytes
func concat = bs => bs
  |> reduce concatStep empty

@test
value isEmpty_empty_bytes : Task Text Bool = pure (isEmpty empty)

@test
value nonEmpty_rejects_empty : Task Text Bool = pure (nonEmpty empty == False)

@test
value concat_empty_list : Task Text Bool = pure (isEmpty (concat []))

@test
value bytes_empty : Task Text Bool = pure (length empty == 0)

@test
value bytes_length : Task Text Bool = pure (length (fromText "abc") == 3)

@test
value bytes_get : Task Text Bool = pure (get 1 (fromText "ABC") == Some 66)

@test
value bytes_slice : Task Text Bool = pure (toText (slice 1 3 (fromText "abcd")) == Some "bc")

@test
value bytes_append : Task Text Bool = pure (toText (append (fromText "ab") (fromText "cd")) == Some "abcd")

@test
value bytes_fromText : Task Text Bool = pure (length (fromText "é") == 2)

@test
value bytes_toText : Task Text Bool = pure (toText (fromText "hello") == Some "hello")

@test
value bytes_repeat : Task Text Bool = pure (toText (repeat 65 3) == Some "AAA")

export (empty, length, get, slice, append, fromText, toText, repeat, isEmpty, nonEmpty, concat)

instance Semigroup Bytes = {
    append = append
}

instance Monoid Bytes = {
    empty = empty
}

instance Default Bytes = {
    default = empty
}
