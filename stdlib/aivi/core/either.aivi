type Either L R =
  | Left L
  | Right R

type EitherPartition L R = {
    lefts: List L,
    rights: List R
}

type Either L R -> Bool
func isLeft = either => either
 ||> Left _  -> True
 ||> Right _ -> False

type Either L R -> Bool
func isRight = either => either
 ||> Left _  -> False
 ||> Right _ -> True

type Either L R -> (Option L)
func fromLeft = either => either
 ||> Left v  -> Some v
 ||> Right _ -> None

type Either L R -> (Option R)
func fromRight = either => either
 ||> Left _  -> None
 ||> Right v -> Some v

type (L1 -> L2) -> (Either L1 R) -> (Either L2 R)
func mapLeft = f either => either
 ||> Left v  -> Left (f v)
 ||> Right v -> Right v

type (R1 -> R2) -> (Either L R1) -> (Either L R2)
func mapRight = f either => either
 ||> Left v  -> Left v
 ||> Right v -> Right (f v)

type (L1 -> L2) -> (R1 -> R2) -> (Either L1 R1) -> (Either L2 R2)
func mapBoth = onLeft onRight either => either
 ||> Left v  -> Left (onLeft v)
 ||> Right v -> Right (onRight v)

type (L -> C) -> (R -> C) -> (Either L R) -> C
func fold = onLeft onRight either => either
 ||> Left v  -> onLeft v
 ||> Right v -> onRight v

type Either L R -> (Either R L)
func swap = either => either
 ||> Left v  -> Right v
 ||> Right v -> Left v

type Either L R -> (Option R)
func toOption = either => either
 ||> Left _  -> None
 ||> Right v -> Some v

type Either L R -> (Result L R)
func toResult = either => either
 ||> Left e  -> Err e
 ||> Right v -> Ok v

type Result E A -> (Either E A)
func fromResult = result => result
 ||> Ok v  -> Right v
 ||> Err e -> Left e

type EitherPartition L R -> L -> (EitherPartition L R)
func addLeftItem = acc v => acc
 ||> { lefts, rights } -> { lefts: append lefts [v], rights }

type EitherPartition L R -> R -> (EitherPartition L R)
func addRightItem = acc v => acc
 ||> { lefts, rights } -> { lefts, rights: append rights [v] }

type EitherPartition L R -> (Either L R) -> (EitherPartition L R)
func partitionStep = acc item => item
 ||> Left v  -> addLeftItem acc v
 ||> Right v -> addRightItem acc v

type List (Either L R) -> ((List L, List R))
func partitionEithers = items => items
  |> reduce partitionStep { lefts: [], rights: [] }
 ||> { lefts, rights } -> (lefts, rights)

export Either
export Left
export Right
export isLeft
export isRight
export fromLeft
export fromRight
export mapLeft
export mapRight
export mapBoth
export fold
export swap
export toOption
export toResult
export fromResult
export partitionEithers

type Int -> Int
func doubleEitherTest = value =>
    value * 2

type Text -> Text
func markEitherTest = value =>
    "{value}!"

type Text -> Int
func leftSizeEitherTest = value => value == "abc"
 T|> 3
 F|> 0

value eitherItemsForTest : List (Either Text Int) = [
    fromResult (Err "a"),
    fromResult (Ok 1),
    fromResult (Err "b")
]

@test
value either_isLeft : Task Text Bool = pure (isLeft (Left "error"))

@test
value either_isRight : Task Text Bool = pure (isRight (Right 1))

@test
value either_fromLeft : Task Text Bool = pure (fromLeft (Left "error") == Some "error")

@test
value either_fromRight : Task Text Bool = pure (fromRight (Right 1) == Some 1)

@test
value either_mapLeft : Task Text Bool = pure (mapLeft markEitherTest (Left "error") == Left "error!")

@test
value either_mapRight : Task Text Bool = pure (mapRight doubleEitherTest (Right 2) == Right 4)

@test
value either_mapBoth : Task Text Bool = pure (mapBoth markEitherTest doubleEitherTest (Right 2) == Right 4)

@test
value either_fold : Task Text Bool = pure (fold leftSizeEitherTest doubleEitherTest (Left "abc") == 3)

@test
value either_swap : Task Text Bool = pure (swap (Left "error") == Right "error")

@test
value either_toOption : Task Text Bool = pure (toOption (Right 1) == Some 1)

@test
value either_toResult : Task Text Bool = pure (toResult (Right 1) == Ok 1)

@test
value either_fromResult : Task Text Bool = pure (fromResult (Err "error") == Left "error")

@test
value either_partitionEithers : Task Text Bool = pure (partitionEithers eitherItemsForTest == (["a", "b"], [1]))

// Right is the success position; Left short-circuits dependent operations.
instance Functor (Either E) = {
    map = mapRight
}

instance Bifunctor Either = {
    bimap = mapBoth
}

instance Foldable (Either E) = {
    reduce = step seed either =>
        either
        ||> Left _     -> seed
        ||> Right item -> step seed item
}

instance Apply (Either E) = {
    apply = functions values =>
        functions
        ||> Left error      -> Left error
        ||> Right transform -> mapRight transform values
}

instance Applicative (Either E) = {
    pure = item => Right item
}

instance Chain (Either E) = {
    chain = next either =>
        either
        ||> Left error -> Left error
        ||> Right item -> next item
}

instance Monad (Either E) = {
    join = either =>
        either
        ||> Left error   -> Left error
        ||> Right nested -> nested
}
