use aivi.list (
    filter
    length
)

type Set A = { items: List A }

type Eq A => A -> A -> Bool
func notEq = x y => x == y
 T|> False
 F|> True

type Eq A => A -> (List A) -> Bool
func notContains = x items =>
    length (filter (notEq x) items) == length items

type Set A -> Bool
func isEmpty = s =>
    length s.items == 0

type A -> (Set A)
func singleton = v =>
    { items: [v] }

type Eq A => A -> (Set A) -> Bool
func member = v s => notContains v s.items
 T|> False
 F|> True

type Eq A => A -> (Set A) -> (Set A)
func insert = v s => member v s
 T|> s
 F|> { items: append s.items [v] }

type (A -> Bool) -> (Set A) -> (List A)
func filteredItems = pred s => s.items
  |> filter pred

type Eq A => A -> (Set A) -> (Set A)
func remove = v s =>
    {
        items: filteredItems (notEq v) s
    }

type Set A -> Int
func size = s => s.items
  |> length

type Set A -> (List A)
func toList = s =>
    s.items

type Eq A => (Set A) -> A -> (Set A)
func insertItem = acc v =>
    insert v acc

type Eq A => (List A) -> (Set A)
func fromList = items => items
  |> reduce insertItem { items: [] }

export Set
export isEmpty
export singleton
export member
export insert
export remove
export size
export toList
export fromList

@test
value set_singleton : Task Text Bool = pure (size (singleton 1) == 1)

@test
value set_isEmpty : Task Text Bool = pure (isEmpty (remove 1 (singleton 1)))

@test
value set_member : Task Text Bool = pure (member 1 (singleton 1))

@test
value set_insert : Task Text Bool = pure (size (insert 2 (singleton 1)) == 2)

@test
value set_insert_is_idempotent : Task Text Bool = pure (size (insert 1 (singleton 1)) == 1)

@test
value set_remove : Task Text Bool = pure (isEmpty (remove 1 (singleton 1)))

@test
value set_size : Task Text Bool = pure (size (fromList [1, 1, 2]) == 2)

@test
value set_toList : Task Text Bool = pure (toList (singleton 1) == [1])

@test
value set_fromList : Task Text Bool = pure (size (fromList [1, 1, 2]) == 2)
