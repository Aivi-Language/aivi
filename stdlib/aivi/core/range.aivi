type RangeInt = {
    start: Int,
    end: Int
}

type Int -> Int -> (RangeInt)
func make = s e =>
    { start: s, end: e }

type RangeInt -> Bool
func isEmpty = r =>
    r.start > r.end

type RangeInt -> Int -> Bool
func contains = r n =>
    n >= r.start and n <= r.end

type RangeInt -> Int
func length = r => r.start > r.end
 T|> 0
 F|> r.end - r.start + 1

type RangeInt -> RangeInt -> Bool
func overlapsHelper = a b =>
    a.start <= b.end and b.start <= a.end

type RangeInt -> RangeInt -> Bool
func overlaps = a b => isEmpty a or isEmpty b
 T|> False
 F|> overlapsHelper a b

type RangeInt -> Int -> Int
func clampTo = r n => n < r.start
 T|> r.start
 F|> clampHigh r.end n

type Int -> Int -> Int
func clampHigh = hi n => n > hi
 T|> hi
 F|> n

type RangeInt -> Int
func startOf = r =>
    r.start

type RangeInt -> Int
func endOf = r =>
    r.end

type Int -> RangeInt -> (RangeInt)
func shift = delta r =>
    {
        start: r.start + delta,
        end: r.end + delta
    }

type RangeInt -> RangeInt -> (RangeInt)
func intersect = a b =>
    intersectBounds (max a.start b.start) (min a.end b.end)

type Int -> Int -> (RangeInt)
func intersectBounds = s e =>
    { start: s, end: e }

type Int -> Int -> Int
func max = a b => a >= b
 T|> a
 F|> b

type Int -> Int -> Int
func min = a b => a <= b
 T|> a
 F|> b

export RangeInt
export make
export isEmpty
export contains
export length
export overlaps
export clampTo
export startOf
export endOf
export shift
export intersect

type RangeFloat = {
    start: Float,
    end: Float
}

type Float -> Float -> (RangeFloat)
func makeFloat = s e =>
    { start: s, end: e }

type RangeFloat -> Bool
func isEmptyFloat = r =>
    r.start > r.end

type RangeFloat -> Float -> Bool
func containsFloat = r n =>
    n >= r.start and n <= r.end

type RangeFloat -> Float -> Float
func clampToFloat = r n => n < r.start
 T|> r.start
 F|> clampHighFloat r.end n

type Float -> Float -> Float
func clampHighFloat = hi n => n > hi
 T|> hi
 F|> n

type Float -> RangeFloat -> (RangeFloat)
func shiftFloat = delta r =>
    {
        start: r.start + delta,
        end: r.end + delta
    }

type RangeFloat -> Float -> Float
func lerpFloat = r t =>
    r.start + (r.end - r.start) * t

export RangeFloat
export makeFloat
export isEmptyFloat
export containsFloat
export clampToFloat
export shiftFloat
export lerpFloat

@test
value range_make : Task Text Bool = pure (startOf (make 2 4) == 2)

@test
value range_isEmpty : Task Text Bool = pure (isEmpty (make 2 1))

@test
value range_contains : Task Text Bool = pure (contains (make 2 4) 4)

@test
value range_length : Task Text Bool = pure (length (make 2 4) == 3)

@test
value range_overlaps : Task Text Bool = pure (overlaps (make 1 3) (make 3 5))

@test
value range_clampTo : Task Text Bool = pure (clampTo (make 2 4) 7 == 4)

@test
value range_startOf : Task Text Bool = pure (startOf (make 2 4) == 2)

@test
value range_endOf : Task Text Bool = pure (endOf (make 2 4) == 4)

@test
value range_shift : Task Text Bool = pure (startOf (shift 3 (make 2 4)) == 5)

@test
value range_intersect : Task Text Bool = pure (length (intersect (make 1 4) (make 3 6)) == 2)

@test
value range_makeFloat : Task Text Bool = pure (containsFloat (makeFloat 1.0 2.0) 1.5)

@test
value range_isEmptyFloat : Task Text Bool = pure (isEmptyFloat (makeFloat 2.0 1.0))

@test
value range_containsFloat : Task Text Bool = pure (containsFloat (makeFloat 1.0 2.0) 2.0)

@test
value range_clampToFloat : Task Text Bool = pure (clampToFloat (makeFloat 1.0 2.0) 3.0 == 2.0)

@test
value range_shiftFloat : Task Text Bool = pure (containsFloat (shiftFloat 2.0 (makeFloat 1.0 2.0)) 3.5)

@test
value range_lerpFloat : Task Text Bool = pure (lerpFloat (makeFloat 0.0 10.0) 0.25 == 2.5)
