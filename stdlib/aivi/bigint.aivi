use aivi.bigint (
    fromInt
    fromText
    toInt
    toText
    add
    sub
    mul
    div
    mod
    pow
    neg
    abs
    cmp
    eq
    gt
    lt
)

value zero : BigInt = fromInt 0
value one : BigInt = fromInt 1
value negOne : BigInt = neg one

type BigInt -> Bool
func isZero = n =>
    eq n zero

type BigInt -> Bool
func isPositive = n =>
    gt n zero

type BigInt -> Bool
func isNegative = n =>
    lt n zero

type BigInt -> Option BigInt -> Bool
func optionEqualsForTest = expected actual => actual
 ||> Some n -> eq n expected
 ||> None   -> False

type Option BigInt -> Bool
func optionIsNoneForTest = actual => actual
 ||> Some _ -> False
 ||> None   -> True

@test
value bigint_fromInt : Task Text Bool = pure (eq (fromInt 42) (fromInt 42))

@test
value bigint_fromText : Task Text Bool = pure (optionEqualsForTest (fromInt 123) (fromText "123"))

@test
value bigint_fromText_rejects_invalid : Task Text Bool = pure (optionIsNoneForTest (fromText "twelve"))

@test
value bigint_toInt : Task Text Bool = pure (toInt (fromInt 42) == Some 42)

@test
value bigint_toText : Task Text Bool = pure (toText (fromInt 42) == "42")

@test
value bigint_add : Task Text Bool = pure (eq (add (fromInt 20) (fromInt 22)) (fromInt 42))

@test
value bigint_sub : Task Text Bool = pure (eq (sub (fromInt 50) (fromInt 8)) (fromInt 42))

@test
value bigint_mul : Task Text Bool = pure (eq (mul (fromInt 6) (fromInt 7)) (fromInt 42))

@test
value bigint_div : Task Text Bool = pure (optionEqualsForTest (fromInt 42) (div (fromInt 84) (fromInt 2)))

@test
value bigint_div_rejects_zero : Task Text Bool = pure (optionIsNoneForTest (div one zero))

@test
value bigint_mod : Task Text Bool = pure (optionEqualsForTest (fromInt 4) (mod (fromInt 44) (fromInt 5)))

@test
value bigint_pow : Task Text Bool = pure (eq (pow (fromInt 2) 10) (fromInt 1024))

@test
value bigint_neg : Task Text Bool = pure (eq (neg (fromInt 42)) (fromInt (-42)))

@test
value bigint_abs : Task Text Bool = pure (eq (abs (fromInt (-42))) (fromInt 42))

@test
value bigint_cmp : Task Text Bool = pure (cmp (fromInt 2) (fromInt 3) == -1)

@test
value bigint_eq : Task Text Bool = pure (eq (fromInt 5) (fromInt 5))

@test
value bigint_gt : Task Text Bool = pure (gt (fromInt 10) (fromInt 5))

@test
value bigint_lt : Task Text Bool = pure (lt (fromInt 5) (fromInt 10))

@test
value bigint_zero : Task Text Bool = pure (isZero zero)

@test
value bigint_one : Task Text Bool = pure (eq one (fromInt 1))

@test
value bigint_negOne : Task Text Bool = pure (eq negOne (fromInt (-1)))

@test
value bigint_isPositive : Task Text Bool = pure (isPositive one)

@test
value bigint_isNegative : Task Text Bool = pure (isNegative negOne)

export (fromInt, fromText, toInt, toText, add, sub, mul, div, mod, pow, neg, abs, cmp, eq, gt, lt, zero, one, negOne, isZero, isPositive, isNegative)
