hoist hiding (join)

use aivi.text (
    length
    byteLen
    slice
    find
    contains
    startsWith
    endsWith
    toUpper
    toLower
    trim
    trimStart
    trimEnd
    replace
    replaceAll
    split
    repeat
    fromInt
    parseInt
    fromBool
    parseBool
    concat
)

type JoinState = {
    first: Bool,
    value: Text
}

type Text -> JoinState -> Text -> JoinState
func joinStep = separator state part => state.first
 T|> { first: False, value: part }
 F|> { first: False, value: "{state.value}{separator}{part}" }

type JoinState -> Text
func finishJoin = state =>
    state.value

type Text -> Bool
func isEmpty = t =>
    t == ""

type Text -> Bool
func nonEmpty = t =>
    t != ""

type Text -> (List Text) -> Text
func join = separator parts => parts
  |> reduce (joinStep separator) { first: True, value: "" }
  |> finishJoin

type Text -> Text -> Text -> Text
func surround = prefix suffix t =>
    "{prefix}{t}{suffix}"

type Text -> Text -> Text
func withDefault = fallback t => t == ""
 T|> fallback
 F|> t

type Text -> Text
func capitalizeNonEmpty = t =>
    concat [
        toUpper (slice 0 1 t),
        toLower (slice 1 (length t) t)
    ]

type Text -> Text
func capitalize = t => isEmpty t
 T|> t
 F|> capitalizeNonEmpty t

type Text -> Int -> Bool
func hasMinLength = t n =>
    length t >= n

type Text -> Int -> Bool
func hasMaxLength = t n =>
    length t <= n

type Int -> Text -> Text -> Text
func padStartHelper = targetLen padChar t =>
    concat [
        repeat (targetLen - length t) padChar,
        t
    ]

type Int -> Text -> Text -> Text
func padStart = targetLen padChar t => length t >= targetLen
 T|> t
 F|> padStartHelper targetLen padChar t

type Int -> Text -> Text -> Text
func padEndHelper = targetLen padChar t =>
    concat [
        t,
        repeat (targetLen - length t) padChar
    ]

type Int -> Text -> Text -> Text
func padEnd = targetLen padChar t => length t >= targetLen
 T|> t
 F|> padEndHelper targetLen padChar t

type Int -> Text -> Int
func parseIntOrElse = default t => parseInt t
 ||> Some n -> n
 ||> None   -> default

type Text -> List Text
func lines = t =>
    split "\n" t

type Text -> List Text
func words = t =>
    split " " t

type (List Text) -> Text
func unlines = items =>
    join "\n" items

@test
value plain_text_is_non_empty : Task Text Bool = pure (nonEmpty "Ada")

@test
value joined_text_is_non_empty : Task Text Bool =
    pure (
        nonEmpty (
            join ", " [
                "Ada",
                "Grace"
            ]
        )
    )

@test
value surrounded_text_is_non_empty : Task Text Bool = pure (nonEmpty (surround "[" "]" "Ada"))

@test
value text_isEmpty_empty : Task Text Bool = pure (isEmpty "")

@test
value text_isEmpty_nonempty : Task Text Bool = pure (not (isEmpty "hello"))

@test
value text_length_basic : Task Text Bool = pure (length "hello" == 5)

@test
value text_concat_basic : Task Text Bool = pure (concat ["a", "b", "c"] == "abc")

@test
value text_upper_lower : Task Text Bool = pure (toUpper "hello" == "HELLO" and toLower "WORLD" == "world")

@test
value text_trim_basic : Task Text Bool = pure (trim "  hi  " == "hi")

@test
value text_contains_basic : Task Text Bool = pure (contains "ell" "hello")

@test
value text_split_basic : Task Text Bool = pure (split "," "a,b,c" == ["a", "b", "c"])

@test
value text_parseInt_basic : Task Text Bool = pure (parseInt "42" == Some 42)

@test
value text_parseInt_invalid : Task Text Bool = pure (parseInt "abc" == None)

@test
value text_capitalize : Task Text Bool = pure (capitalize "hello" == "Hello")

@test
value text_padStart : Task Text Bool = pure (padStart 5 "0" "42" == "00042")

@test
value text_lines : Task Text Bool = pure (lines "a\nb\nc" == ["a", "b", "c"])

@test
value text_byteLen_counts_utf8_bytes : Task Text Bool = pure (byteLen "é" == 2)

@test
value text_slice_uses_character_indexes : Task Text Bool = pure (slice 1 3 "aéz" == "éz")

@test
value text_find_returns_character_index : Task Text Bool = pure (find "é" "aéz" == Some 1)

@test
value text_startsWith_basic : Task Text Bool = pure (startsWith "hel" "hello")

@test
value text_endsWith_basic : Task Text Bool = pure (endsWith "llo" "hello")

@test
value text_trimStart_preserves_trailing_space : Task Text Bool = pure (trimStart "  hi  " == "hi  ")

@test
value text_trimEnd_preserves_leading_space : Task Text Bool = pure (trimEnd "  hi  " == "  hi")

@test
value text_replace_changes_first_match : Task Text Bool = pure (replace "a" "x" "aba" == "xba")

@test
value text_replaceAll_changes_every_match : Task Text Bool = pure (replaceAll "a" "x" "aba" == "xbx")

@test
value text_repeat_basic : Task Text Bool = pure (repeat 3 "ab" == "ababab")

@test
value text_fromInt_basic : Task Text Bool = pure (fromInt -42 == "-42")

@test
value text_fromBool_basic : Task Text Bool = pure (fromBool True == "True")

@test
value text_parseBool_basic : Task Text Bool = pure (parseBool "False" == Some False)

@test
value text_withDefault_replaces_empty_text : Task Text Bool = pure (withDefault "fallback" "" == "fallback")

@test
value text_hasMinLength_includes_boundary : Task Text Bool = pure (hasMinLength "abc" 3)

@test
value text_hasMaxLength_includes_boundary : Task Text Bool = pure (hasMaxLength "abc" 3)

@test
value text_padEnd : Task Text Bool = pure (padEnd 5 "0" "42" == "42000")

@test
value text_parseIntOrElse_uses_fallback : Task Text Bool = pure (parseIntOrElse 7 "nope" == 7)

@test
value text_words_splits_spaces : Task Text Bool = pure (words "a b c" == ["a", "b", "c"])

@test
value text_unlines_joins_without_trailing_newline : Task Text Bool = pure (unlines ["a", "b"] == "a\nb")

export (length, byteLen, slice, find, contains, startsWith, endsWith, toUpper, toLower, trim, trimStart, trimEnd, replace, replaceAll, split, repeat, fromInt, parseInt, fromBool, parseBool, concat, isEmpty, nonEmpty, join, surround, withDefault, capitalize, hasMinLength, hasMaxLength, padStart, padEnd, parseIntOrElse, lines, words, unlines)
