hoist

type Int -> Int
func abs = n => n < 0
 T|> 0 - n
 F|> n

type Int -> Int
func negate = n =>
    0 - n

type Int -> Int
func negOrZero = n => n < 0
 T|> 0 - 1
 F|> 0

type Int -> Int
func sign = n => n > 0
 T|> 1
 F|> negOrZero n

type Int -> Bool
func isEven = n =>
    n % 2 == 0

type Int -> Bool
func isOdd = n =>
    n % 2 != 0

type Int -> Int
func square = n =>
    n * n

type Int -> Int -> Int
func clampTop = high n => n > high
 T|> high
 F|> n

type Int -> Int -> Int -> Int
func clamp = low high n => n < low
 T|> low
 F|> clampTop high n

type Int -> Int -> Int -> Bool
func between = low high n =>
    n >= low and n <= high

type Int -> Int -> Bool
func divides = divisor n => divisor == 0
 T|> n == 0
 F|> n % divisor == 0

type Int -> Int -> Int
func gcd = a b => b == 0
 T|> abs a
 F|> gcd b (a % b)

type Int -> Int -> Int
func lcmHelper = a b =>
    abs (a * b / gcd a b)

type Int -> Bool -> Int -> Int
func lcmCheckB = a bIsZero b => bIsZero
 T|> 0
 F|> lcmHelper a b

type Int -> Int -> Int
func lcm = a b => a == 0
 T|> 0
 F|> lcmCheckB a (b == 0) b

type Int -> Int -> Int -> Int
func powHelper = base exp acc => exp == 0
 T|> acc
 F|> powStep base exp acc

type Int -> Int -> Int -> Int
func powStep = base exp acc => exp % 2 == 0
 T|> powHelper (base * base) (exp / 2) acc
 F|> powHelper (base * base) (exp / 2) (acc * base)

type Int -> Int -> Int
func pow = base exp => exp < 0
 T|> 0
 F|> powHelper base exp 1

@test
value abs_handles_negative : Task Text Bool = pure (abs (0 - 4) == 4)

@test
value negate_flips_sign : Task Text Bool = pure (negate 4 == -4)

@test
value sign_reports_negative : Task Text Bool = pure (sign (-4) == -1)

@test
value even_detects_even : Task Text Bool = pure (isEven 6)

@test
value odd_detects_odd : Task Text Bool = pure (isOdd 7)

@test
value square_multiplies_value : Task Text Bool = pure (square 6 == 36)

@test
value clamp_restricts_high_value : Task Text Bool = pure (clamp 0 10 20 == 10)

@test
value between_includes_boundary : Task Text Bool = pure (between 0 10 10)

@test
value divides_detects_factor : Task Text Bool = pure (divides 3 12)

@test
value zero_divides_only_zero : Task Text Bool = pure (divides 0 0 and not (divides 0 1))

@test
value gcd_of_12_and_8 : Task Text Bool = pure (gcd 12 8 == 4)

@test
value lcm_of_4_and_6 : Task Text Bool = pure (lcm 4 6 == 12)

@test
value pow_2_to_10 : Task Text Bool = pure (pow 2 10 == 1024)

export abs
export negate
export sign
export isEven
export isOdd
export square
export clamp
export between
export divides
export gcd
export lcm
export pow
