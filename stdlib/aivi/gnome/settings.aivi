type SettingsError =
  | SchemaNotFound Text
  | KeyNotFound Text
  | TypeMismatch Text
  | SettingsUnavailable

// Text alias for GSettings schema IDs (e.g. "org.gnome.desktop.interface")
type SettingsSchema = Text

// Text alias for settings key paths
type SettingsKey = Text

// Typed setting values
type SettingValue =
  | SettingBool Bool
  | SettingInt Int
  | SettingFloat Float
  | SettingText Text
  | SettingList (List Text)

type SettingsTask A = (Task SettingsError A)

export (SettingsError, SchemaNotFound, KeyNotFound, TypeMismatch, SettingsUnavailable, SettingsSchema, SettingsKey, SettingValue, SettingBool, SettingInt, SettingFloat, SettingText, SettingList, SettingsTask)
