hoist

type (A -> A -> Bool) -> A -> A -> A
func chooseMinBy = compare best candidate => compare candidate best
 T|> candidate
 F|> best

type (A -> A -> Bool) -> A -> A -> A
func chooseMaxBy = compare best candidate => compare best candidate
 T|> candidate
 F|> best

type (A -> A -> Bool) -> A -> A -> A
func minBy = compare left right =>
    chooseMinBy compare left right

type (A -> A -> Bool) -> A -> A -> A
func maxBy = compare left right =>
    chooseMaxBy compare left right

type (A -> A -> Bool) -> A -> (List A) -> A
func minOfBy = compare first rest => rest
  |> reduce (chooseMinBy compare) first

type (A -> A -> Bool) -> A -> (List A) -> A
func maxOfBy = compare first rest => rest
  |> reduce (chooseMaxBy compare) first

type (A -> A -> Bool) -> A -> A -> A -> A
func clampBy = compare low high value => compare value low
 T|> low
 F|> clampToMaxBy compare high value

type (A -> A -> Bool) -> A -> A -> A
func clampToMaxBy = compare high value => compare high value
 T|> high
 F|> value

type (A -> A -> Bool) -> A -> A -> Bool
func reversed = compare left right =>
    compare right left

type (A -> B) -> (B -> B -> Bool) -> A -> A -> Bool
func comparing = project compare left right =>
    compare (project left) (project right)

export min
export max
export minOf
export maxOf
export clamp
export minBy
export maxBy
export minOfBy
export maxOfBy
export clampBy
export reversed
export comparing

type Int -> Int -> Bool
func lessOrderTest = left right =>
    left < right

type (Int, Text) -> Int
func firstOrderTest = pair => pair
 ||> (first, _) -> first

@test
value order_minBy : Task Text Bool = pure (minBy lessOrderTest 3 2 == 2)

@test
value order_maxBy : Task Text Bool = pure (maxBy lessOrderTest 3 2 == 3)

@test
value order_minOfBy : Task Text Bool = pure (minOfBy lessOrderTest 3 [2, 4] == 2)

@test
value order_maxOfBy : Task Text Bool = pure (maxOfBy lessOrderTest 3 [2, 4] == 4)

@test
value order_clampBy : Task Text Bool = pure (clampBy lessOrderTest 1 3 5 == 3)

@test
value order_reversed : Task Text Bool = pure (reversed lessOrderTest 3 2)

@test
value order_comparing : Task Text Bool =
    pure (
        comparing firstOrderTest lessOrderTest (1, "b") (
            2,
            "a"
        )
    )

@test
value order_min : Task Text Bool = pure (min 3 2 == 2)

@test
value order_max : Task Text Bool = pure (max 3 2 == 3)

@test
value order_minOf : Task Text Bool = pure (minOf 3 [2, 4] == 2)

@test
value order_maxOf : Task Text Bool = pure (maxOf 3 [2, 4] == 4)

@test
value order_clamp : Task Text Bool = pure (clamp 1 3 5 == 3)
