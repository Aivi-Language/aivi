{
  "mcpServers": {
    "Crusty": {
      "command": "rust-repo-intelligence",
      "args": ["--workspace", "."]
    },
    "Aivi": {
      "command": "cargo",
      "args": [
        "run",
        "--quiet",
        "--locked",
        "--bin",
        "aivi",
        "--",
        "mcp",
        "--path",
        "demos/snake.aivi"
      ]
    }
  }
}
